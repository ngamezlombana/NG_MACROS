%
O8110 (ACABADO DE BOLSILLO RECTANGULAR O MARCO)
(INGENIERO NESTOR GAMEZ - FANUC CNC CUSTOM MACROS)
(LLAMADA G65: G65 P8110 X.. Y.. W.. H.. R.. T.. F.. S.. Z.. B..)

(VARIABLES DE ENTRADA DEL OPERARIO)
(1. DIMENSIONES GEOMETRICAS)
#24 = 0.0    (X: COORDENADA X DEL CENTRO DE LA CAJERA)
#25 = 0.0    (Y: COORDENADA Y DEL CENTRO DE LA CAJERA)
#23 = 100.0  (W: LONGITUD DE LA CAJERA EN EJE X)
#11 = 60.0   (H: ANCHURA DE LA CAJERA EN EJE Y)
#18 = 10.0   (R: RADIO DE LAS ESQUINAS INTERIORES)

(2. CONDICIONES DE CORTE Y HERRAMIENTA)
#20 = 10.0   (T: DIAMETRO DE LA FRESA DE ACABADO)
#9  = 350.0  (F: VELOCIDAD DE AVANCE DE CORTE EN MM/MIN)
#19 = 1800.0 (S: VELOCIDAD DEL HUSILLO EN RPM)

(3. ESTRATEGIA DE MECANIZADO Y SEGURIDAD)
#26 = 12.0   (Z: PROFUNDIDAD TERMINADA DE LA CAJERA)
#2  = 2.0    (B: PLANO DE SEGURIDAD EN Z)

(CONTROL DE ERRORES Y SEGURIDAD)
IF [#23 LE 0] GOTO9101
IF [#11 LE 0] GOTO9102
IF [#18 LE 0] GOTO9103
IF [#20 LE 0] GOTO9104
IF [#9 LE 0]  GOTO9105
IF [#26 LE 0] GOTO9106
IF [#19 LE 0] GOTO9109
IF [#2 EQ 0] #2 = 2.0

#10 = #4003
#14 = #23 / 2.0 (SEMI-LONGITUD NOMINAL EN X)
#31 = #11 / 2.0 (SEMI-ANCHURA NOMINAL EN Y)
#15 = #20 / 2.0 (RADIO DE LA FRESA)
#16 = #14 - #15 (SEMI-LONGITUD DE TRAYECTORIA)
#17 = #31 - #15 (SEMI-ANCHURA DE TRAYECTORIA)
#33 = #18 - #15 (RADIO DE ESQUINA DE TRAYECTORIA)

IF [#16 LE 0] GOTO9107
IF [#17 LE 0] GOTO9107
IF [#33 LE 0] GOTO9108

(ARRANQUE DE HUSILLO Y POSICIONAMIENTO INICIAL EN EL CENTRO)
G90 G00 S#19 M03
G00 X#24 Y#25
G00 Z50.0
G00 Z#2
G01 Z-[#26] F[#9 * 0.4]

(ENTRADA AL BORDE INFERIOR DE LA CAJERA)
G01 X#24 Y[#25 - #17] F#9

(BORDE INFERIOR - MITAD DERECHA)
G01 X[#24 + #16 - #33] Y[#25 - #17]

(ESQUINA INFERIOR DERECHA)
G03 X[#24 + #16] Y[#25 - #17 + #33] I0.0 J#33

(BORDE DERECHO)
G01 X[#24 + #16] Y[#25 + #17 - #33]

(ESQUINA SUPERIOR DERECHA)
G03 X[#24 + #16 - #33] Y[#25 + #17] I-[#33] J0.0

(BORDE SUPERIOR)
G01 X[#24 - #16 + #33] Y[#25 + #17]

(ESQUINA SUPERIOR IZQUIERDA)
G03 X[#24 - #16] Y[#25 + #17 - #33] I0.0 J-[#33]

(BORDE IZQUIERDO)
G01 X[#24 - #16] Y[#25 - #17 + #33]

(ESQUINA INFERIOR IZQUIERDA)
G03 X[#24 - #16 + #33] Y[#25 - #17] I[#33] J0.0

(BORDE INFERIOR - CIERRE Y DESPEGUE SEGURO)
G01 X#24 Y[#25 - #17]
G90 G00 Z#2
G00 X#24 Y#25

(RETIRADA A PLANO DE SEGURIDAD)
G90 G00 Z50.0
GOTO9999

(MENSAJES DE ALARMA DE SEGURIDAD #3000)
N9101 #3000 = 101 (LONGITUD W EN EJE X DEBE SER MAYOR A CERO)
N9102 #3000 = 102 (ANCHURA H EN EJE Y DEBE SER MAYOR A CERO)
N9103 #3000 = 103 (RADIO DE ESQUINA R DEBE SER MAYOR A CERO)
N9104 #3000 = 104 (DIAMETRO DE HERRAMIENTA T DEBE SER MAYOR A CERO)
N9105 #3000 = 105 (AVANCE F DEBE SER MAYOR A CERO)
N9106 #3000 = 106 (PROFUNDIDAD Z DEBE SER MAYOR A CERO)
N9107 #3000 = 107 (HERRAMIENTA EXCEDE LAS DIMENSIONES DE LA CAJERA)
N9108 #3000 = 108 (RADIO DE ESQUINA MENOR QUE RADIO DE HERRAMIENTA)
N9109 #3000 = 109 (VELOCIDAD DE HUSILLO S DEBE SER MAYOR A CERO)

N9999 G#10
M99
%
