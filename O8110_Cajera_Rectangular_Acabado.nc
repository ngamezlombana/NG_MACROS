%
O8110 (ACABADO DE BOLSILLO RECTANGULAR O MARCO)
(PETER SMID - FANUC CNC CUSTOM MACROS - CAPITULO 20)
(LLAMADA G65: G65 P8110 W.. H.. Z.. R.. D.. F..)

(VARIABLES DE ENTRADA DEL OPERARIO)
#23 = 100.0  (W: LONGITUD DE LA CAJERA EN EJE X)
#11 = 60.0   (H: ANCHURA DE LA CAJERA EN EJE Y)
#26 = 12.0   (Z: PROFUNDIDAD TERMINADA DE LA CAJERA)
#18 = 10.0   (R: RADIO DE LAS ESQUINAS INTERIORES)
#7  = 5.0    (D: RADIO DE LA HERRAMIENTA O NUMERO CORRECTOR)
#9  = 350.0  (F: VELOCIDAD DE AVANCE DE CORTE EN MM/MIN)

(CONTROL DE ERRORES Y SEGURIDAD)
IF [#23 LE 0] GOTO9101
IF [#11 LE 0] GOTO9102
IF [#18 LE 0] GOTO9103
IF [#7 LE 0]  GOTO9104
IF [#9 LE 0]  GOTO9105
IF [#26 LE 0] GOTO9106
IF [#7 GE #18] GOTO9107

#10 = #4003 (ALMACENAR G90/G91)
#31 = ABS[#11 / 2.0]
#32 = #31 / 2.0
#33 = ABS[#23 / 2.0]

(POSICIONAMIENTO INICIAL EN EL CENTRO X0 Y0 DE LA CAJERA)
G90 G00 X0.0 Y0.0
G00 Z2.0
G01 Z-[#26] F[#9 / 2.0]

(APROXIMACION LINEAL CON G41 Y ARCO TANGENCIAL)
G91 G01 G41 X-[#32] Y-[#32] D7 F[#9 * 1.5]
G03 X#32 Y-[#32] I#32 J0.0 F#9

(PARED INFERIOR - MITAD DERECHA)
G01 X[#33 - #18]
(ESQUINA INFERIOR DERECHA)
G03 X#18 Y#18 I0.0 J#18

(PARED DERECHA)
G01 Y[2.0 * [#31 - #18]]
(ESQUINA SUPERIOR DERECHA)
G03 X-[#18] Y#18 I-[#18] J0.0

(PARED SUPERIOR)
G01 X-[2.0 * [#33 - #18]]
(ESQUINA SUPERIOR IZQUIERDA)
G03 X-[#18] Y-[#18] I0.0 J-[#18]

(PARED IZQUIERDA)
G01 Y-[2.0 * [#31 - #18]]
(ESQUINA INFERIOR IZQUIERDA)
G03 X#18 Y-[#18] I#18 J0.0

(PARED INFERIOR - MITAD IZQUIERDA HASTA PUNTO MEDIO)
G01 X[#33 - #18]

(SALIDA TANGENCIAL EN ARCO Y RETORNO LINEAL CANCELANDO G40)
G03 X#32 Y#32 I0.0 J#32
G01 G40 X-[#32] Y#32 F[#9 * 1.5]

(RETIRADA A PLANO DE SEGURIDAD)
G90 G00 Z5.0
GOTO9999

(MENSAJES DE ALARMA DE SEGURIDAD #3000)
N9101 #3000 = 101 (LONGITUD W EN EJE X DEBE SER MAYOR A CERO)
N9102 #3000 = 102 (ANCHURA H EN EJE Y DEBE SER MAYOR A CERO)
N9103 #3000 = 103 (RADIO DE ESQUINA R DEBE SER MAYOR A CERO)
N9104 #3000 = 104 (RADIO DE HERRAMIENTA D DEBE SER MAYOR A CERO)
N9105 #3000 = 105 (AVANCE F DEBE SER MAYOR A CERO)
N9106 #3000 = 106 (PROFUNDIDAD Z DEBE SER MAYOR A CERO)
N9107 #3000 = 107 (RADIO DE HERRAMIENTA EXCEDE RADIO DE ESQUINA)

N9999 G#10
M99
%
