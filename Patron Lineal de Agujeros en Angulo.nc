O1009 (PATRON LINEAL DE AGUJEROS EN ANGULO V1)

(========================================)
(--- VARIABLES DE ENTRADA DEL OPERARIO ---)
#20 = 1     (NUMERO DE HERRAMIENTA)
(========================================)
#1 = 3      (NUMERO TOTAL DE AGUJEROS)
#2 = 40.0   (DISTANCIA PASO ENTRE AGUJEROS)
#3 = 25.0   (ANGULO DE INCLINACION RESPECTO AL EJE X EN GRADOS)
#4 = 10.0   (DIAMETRO DE LA BROCA)
#5 = 2500   (RPM)
#6 = 300.0  (AVANCE F)
#7 = 20.0   (PROFUNDIDAD Z TOTAL)
#8 = 1      (ESTRATEGIA: 0=DIRECTO, 1=PICOTEO)
#9 = 5.0    (PASO PICOTEO)
#10 = 5.0   (SEGURIDAD SOBRE PIEZA)
#11 = 0.0   (PUNTO INICIAL X)
#12 = 0.0   (PUNTO INICIAL Y)
#13 = 0.0   (Z INICIAL SUPERFICIE)
#14 = 1.0   (AGUJERO DE INICIO)
#15 = 3.0   (AGUJERO FINAL - EJ: 3 HACE HASTA EL ULTIMO)
(========================================)

(--- COMPROBACIONES Y AJUSTES DE RANGO ---)
IF [#1 LT 1] GOTO 9001
IF [#14 LT 1] GOTO 9006
IF [#15 GT #1] THEN #15 = #1
IF [#14 GT #15] GOTO 9007
IF [#2 LE 0] GOTO 9002

(--- CALCULOS AUXILIARES ---)
#104 = #13 - #7 (FONDO Z DE TALADRADO)
#109 = #13 + #10 (PLANO DE SEGURIDAD RETRACT)

(--- INICIALIZACION DEL CONTADOR ---)
#110 = #14 - 1 (INDICE ACTUAL BASE CERO)
#117 = #15     (INDICE LIMITE FINAL)

T#20 M06 (LLAMAR HERRAMIENTA)
G90 G54 G17 G40 G80 G49
S#5 M03
M08

N10 (--- BUCLE PRINCIPAL DE PERFORADO LINEAL ---)
IF [#110 GE #117] GOTO 999

(CALCULO DE COORDENADAS X E Y INCLINADAS)
#118 = #110 * #2
#112 = #11 + [#118 * COS[#3]]
#113 = #12 + [#118 * SIN[#3]]

G00 X#112 Y#113
G43 H#20 Z#109

(SELECCION DE ESTRATEGIA: DIRECTO O PICOTEO)
IF [#8 EQ 1] GOTO 50

(ESTRATEGIA DIRECTA: G01 HASTA FONDO Z)
G01 Z#104 F#6
G00 Z#109
GOTO 100

N50 (ESTRATEGIA CON PICOTEO PECK DRILLING)
#106 = #13
N55
#107 = #106 - #9
IF [#107 LT #104] THEN #107 = #104
G00 Z[#106 + 1.0]
G01 Z#107 F#6
G00 Z#109
#106 = #107
IF [#106 GT #104] GOTO 55

N100
#110 = #110 + 1
GOTO 10

N999
G00 Z[#109 + 50.0]
M09 M05
G28 G91 Z0.
G90
M30

(--- ALARMAS DE CONTROL CNC ---)
N9001 #3000=1 (ERROR: TOTAL AGUJEROS < 1)
N9002 #3000=2 (ERROR: PASO ENTRE AGUJEROS <= 0)
N9006 #3000=6 (ERROR: AGUJERO INICIO < 1)
N9007 #3000=7 (ERROR: AGUJERO INICIO > AGUJERO FINAL)
