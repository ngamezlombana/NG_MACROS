%
O8105 (PATRON DE AGUJEROS EN ARCO CIRCULAR)
(INGENIERO NESTOR GAMEZ - FANUC CNC CUSTOM MACROS)
(LLAMADA G65: G65 P8105 X.. Y.. W.. H.. A.. I.. T.. F.. S.. Z.. R.. E..)

(VARIABLES DE ENTRADA DEL OPERARIO)
(1. DIMENSIONES GEOMETRICAS)
#24 = 0.0    (X: COORDENADA X DEL CENTRO DEL ARCO)
#25 = 0.0    (Y: COORDENADA Y DEL CENTRO DEL ARCO)
#23 = 100.0  (W: DIAMETRO DEL ARCO DE AGUJEROS)
#11 = 6.0    (H: CANTIDAD DE AGUJEROS EN EL ARCO)
#1  = 15.0   (A: ANGULO DEL PRIMER AGUJERO DESDE EJE X+)
#4  = 30.0   (I: SEPARACION ANGULAR ENTRE AGUJEROS CONSECUTIVOS)

(2. CONDICIONES DE CORTE Y HERRAMIENTA)
#20 = 10.0   (T: DIAMETRO DE LA BROCA / HERRAMIENTA)
#9  = 250.0  (F: AVANCE DE TALADRADO EN MM/MIN)
#19 = 1200.0 (S: VELOCIDAD DEL HUSILLO EN RPM)

(3. ESTRATEGIA DE PERFORADO Y SEGURIDAD)
#26 = 20.0   (Z: PROFUNDIDAD TOTAL DE PERFORACION)
#18 = 2.0    (R: PLANO DE RETROCESO Y SEGURIDAD)
#8  = 5.0    (E: PASO DE PICOTEO EN Z PARA G83)

(CONTROL DE ERRORES Y SEGURIDAD)
#10 = #4003
IF [#23 LE 0] GOTO9101
IF [#11 LT 1] GOTO9102
IF [#11 NE FUP[#11]] GOTO9103
IF [#4 EQ 0] GOTO9104
IF [#26 LE 0] GOTO9105
IF [#9 LE 0] GOTO9106
IF [#20 LE 0] GOTO9107
IF [#8 LE 0] GOTO9108
IF [#18 LT 0] #18 = 2.0

(RADIO DEL ARCO)
#14 = #23 / 2.0

(ARRANQUE DE HUSILLO)
G90 G00 S#19 M03

(BUCLE DE PERFORACION EN ARCO)
#33 = 1.0
WHILE [#33 LE #11] DO1
  #30 = #1 + [[#33 - 1.0] * #4]
  #15 = COS[#30] * #14 + #24
  #16 = SIN[#30] * #14 + #25
  G00 X#15 Y#16
  G99 G83 Z-[#26] R#18 Q#8 F#9
  #33 = #33 + 1.0
END1

G80 (CANCELAR CICLO FIJO)
G90 G00 Z25.0
GOTO9999

(MENSAJES DE ALARMA DE SEGURIDAD #3000)
N9101 #3000 = 101 (DIAMETRO DEL ARCO DEBE SER MAYOR A CERO)
N9102 #3000 = 102 (MINIMO 1 AGUJERO EN EL ARCO)
N9103 #3000 = 103 (CANTIDAD DE AGUJEROS DEBE SER ENTERO)
N9104 #3000 = 104 (INCREMENTO ANGULAR I NO PUEDE SER CERO)
N9105 #3000 = 105 (PROFUNDIDAD Z DEBE SER MAYOR A CERO)
N9106 #3000 = 106 (AVANCE F DEBE SER MAYOR A CERO)
N9107 #3000 = 107 (DIAMETRO DE HERRAMIENTA T DEBE SER MAYOR A CERO)
N9108 #3000 = 108 (PASO DE PICOTEO E DEBE SER MAYOR A CERO)

N9999 G#10
M99
%
