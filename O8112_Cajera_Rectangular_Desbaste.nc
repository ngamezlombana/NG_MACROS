%
O8112 (DESBASTE DE CAJERA RECTANGULAR)
(PETER SMID - FANUC CNC CUSTOM MACROS - CAPITULO 20)
(LLAMADA G65: G65 P8112 X.. Y.. W.. H.. R.. Z.. K.. E.. T.. F.. S.. B..)

(VARIABLES DE ENTRADA DEL OPERARIO)
(1. DIMENSIONES GEOMETRICAS DE LA PIEZA)
#24 = 0.0    (X: COORDENADA X DEL CENTRO DE LA CAJERA)
#25 = 0.0    (Y: COORDENADA Y DEL CENTRO DE LA CAJERA)
#23 = 100.0  (W: LONGITUD TOTAL DE LA CAJERA EN EJE X)
#11 = 60.0   (H: ANCHURA TOTAL DE LA CAJERA EN EJE Y)
#18 = 10.0   (R: RADIO DE LAS ESQUINAS INTERIORES)

(2. CONDICIONES DE CORTE Y HERRAMIENTA)
#20 = 10.0   (T: DIAMETRO DE LA FRESA O CORTADOR)
#9  = 350.0  (F: VELOCIDAD DE AVANCE DE CORTE EN MM/MIN)
#19 = 1800.0 (S: VELOCIDAD DEL HUSILLO EN RPM)

(3. ESTRATEGIA DE MECANIZADO Y SEGURIDAD)
#26 = 15.0   (Z: PROFUNDIDAD TOTAL DE LA CAJERA)
#6  = 3.0    (K: PASO DE PROFUNDIDAD EN Z POR PASADA)
#8  = 6.0    (E: PASO LATERAL RADIAL ENTRE CONTORNOS)
#2  = 2.0    (B: PLANO DE RETROCESO Y SEGURIDAD EN Z)

(CONTROL DE ERRORES Y SEGURIDAD)
IF [#23 LE 0] #3000 = 101 (LONGITUD W INVALIDA)
IF [#11 LE 0] #3000 = 102 (ANCHURA H INVALIDA)
IF [#26 LE 0] #3000 = 103 (PROFUNDIDAD Z INVALIDA)
IF [#20 LE 0] #3000 = 104 (DIAMETRO DE HERRAMIENTA INVALIDO)
IF [#6 LE 0]  #3000 = 105 (PASO EN Z K INVALIDO)
#15 = #20 / 2.0
IF [#15 GT #18] #3000 = 106 (RADIO FRESA MAYOR QUE RADIO ESQUINA)

#26 = -ABS[#26]
#27 = ABS[#6]
#28 = ABS[#8]
IF [#28 EQ 0] #28 = #20 * 0.65
IF [#2 EQ 0]  #2 = 2.0

#10 = #20 / 2.0
#12 = [#23 / 2.0] - #10
#13 = [#11 / 2.0] - #10
#14 = #18 - #10
IF [#14 LT 0] #14 = 0

#15 = #12
IF [#13 GT #15] #15 = #13
#16 = FIUP[#15 / #28]
IF [#16 LT 1] #16 = 1

(ARRANQUE DE HUSILLO Y POSICIONAMIENTO EN CENTRO)
G90 G00 S#19 M03
G00 X#24 Y#25
G00 Z#2

#30 = 0
WHILE [#30 GT #26] DO 1
    #30 = #30 - #27
    IF [#30 LT #26] #30 = #26

    (INMERSION EN Z EN EL CENTRO)
    G00 X#24 Y#25
    G01 Z#30 F[#9 * 0.5]

    (DESBASTE CONCENTRICO DE ADENTRO HACIA AFUERA)
    #31 = 1
    WHILE [#31 LE #16] DO 2
        #32 = [#12 * #31] / #16
        #33 = [#13 * #31] / #16
        #34 = [#14 * #31] / #16

        G01 X[#24 + #32 - #34] Y[#25 - #33] F#9
        G03 X[#24 + #32] Y[#25 - #33 + #34] R#34
        G01 Y[#25 + #33 - #34]
        G03 X[#24 + #32 - #34] Y[#25 + #33] R#34
        G01 X[#24 - #32 + #34]
        G03 X[#24 - #32] Y[#25 + #33 - #34] R#34
        G01 Y[#25 - #33 + #34]
        G03 X[#24 - #32 + #34] Y[#25 - #33] R#34
        G01 X[#24 + #32 - #34]

        #31 = #31 + 1
    END 2

    (RETORNO AL PLANO SEGURO)
    G00 Z#2
END 1

G00 Z[#2 + 25.0]
M99
%
