%
O8112 (DESBASTE DE CAJERA RECTANGULAR)
(INGENIERO NESTOR GAMEZ - FANUC CNC CUSTOM MACROS)
(LLAMADA G65: G65 P8112 X.. Y.. W.. H.. R.. T.. F.. S.. Z.. K.. E.. U.. V.. B..)

(VARIABLES DE ENTRADA DEL OPERARIO)
(1. DIMENSIONES GEOMETRICAS DE LA PIEZA)
#24 = 0.0    (X: COORDENADA X DEL CENTRO DE LA CAJERA)
#25 = 0.0    (Y: COORDENADA Y DEL CENTRO DE LA CAJERA)
#23 = 100.0  (W: LONGITUD TOTAL DE LA CAJERA EN EJE X)
#11 = 60.0   (H: ANCHURA TOTAL DE LA CAJERA EN EJE Y)
#18 = 10.0   (R: RADIO DE LAS ESQUINAS INTERIORES)

(2. CONDICIONES DE CORTE Y HERRAMIENTA)
#20 = 10.0   (T: DIAMETRO DE LA FRESA O CORTADOR)
#9  = 350.0  (F: VELOCIDAD DE AVANCE DE CORTE EN MM/MIN)
#19 = 1800.0 (S: VELOCIDAD DEL HUSILLO EN RPM)

(3. ESTRATEGIA DE MECANIZADO Y SOBREMATERIAL DE ACABADO)
#26 = 15.0   (Z: PROFUNDIDAD TOTAL DE LA CAJERA)
#6  = 3.0    (K: PASO DE PROFUNDIDAD EN Z POR PASADA)
#8  = 6.0    (E: PASO LATERAL RADIAL ENTRE CONTORNOS)
#21 = 0.5    (U: SOBREMATERIAL DE ACABADO EN PAREDES LATERALES)
#22 = 0.2    (V: SOBREMATERIAL DE ACABADO EN EL FONDO Z)
#2  = 2.0    (B: PLANO DE RETROCESO Y SEGURIDAD EN Z)

(CONTROL DE ERRORES Y SEGURIDAD)
IF [#23 LE 0] GOTO9101
IF [#11 LE 0] GOTO9102
IF [#26 LE 0] GOTO9103
IF [#20 LE 0] GOTO9104
IF [#6 LE 0]  GOTO9105
IF [#9 LE 0]  GOTO9109
IF [#19 LE 0] GOTO9110
#15 = #20 / 2.0
IF [#15 GE #18] GOTO9106
IF [#2 EQ 0] #2 = 2.0

(GUARDA ESTADO PREVIO DE G90/G91)
#10 = #4003

#21 = ABS[#21]       (SOBREMATERIAL PAREDES U)
#22 = ABS[#22]       (SOBREMATERIAL FONDO V)

#10 = #20 / 2.0      (RADIO DE LA FRESA)
#12 = [#23 / 2.0] - #10 - #21
#13 = [#11 / 2.0] - #10 - #21
#14 = #18 - #10 - #21
IF [#14 LT 0] #14 = 0

IF [#12 LE 0] GOTO9107
IF [#13 LE 0] GOTO9108

#27 = ABS[#6]
#28 = ABS[#8]
IF [#28 EQ 0] #28 = #20 * 0.65
IF [#2 EQ 0] #2 = 2.0

#15 = #12
IF [#13 GT #15] #15 = #13
#16 = FUP[#15 / #28]
IF [#16 LT 1] #16 = 1

(CALCULO DE PROFUNDIDAD EFECTIVA CON SOBREMATERIAL DE FONDO V)
#29 = ABS[#26] - #22
IF [#29 LE 0] #29 = ABS[#26]
#29 = -#29

(ARRANQUE DE HUSILLO Y POSICIONAMIENTO EN CENTRO)
S#19 M03 M08
G90 G00 X#24 Y#25
G00 Z50.0             (PLANO SEGURO INICIAL)
G00 Z#2               (PLANO DE RETROCESO B)

#30 = 0
WHILE [#30 GT #29] DO1
    #30 = #30 - #27
    IF [#30 LT #29] #30 = #29

    (INMERSION EN Z EN EL CENTRO CON AVANCE CONTROLADO)
    G00 X#24 Y#25
    G01 Z#30 F[#9 * 0.4]

    (DESBASTE CONCENTRICO DE ADENTRO HACIA AFUERA)
    #31 = 1
    WHILE [#31 LE #16] DO2
        #32 = [#12 * #31] / #16
        #33 = [#13 * #31] / #16
        #5  = [#14 * #31] / #16
        IF [#5 LT 0.01] #5 = 0.01

        G01 X[#24 + #32 - #5] Y[#25 - #33] F#9
        G03 X[#24 + #32] Y[#25 - #33 + #5] R#5
        G01 Y[#25 + #33 - #5]
        G03 X[#24 + #32 - #5] Y[#25 + #33] R#5
        G01 X[#24 - #32 + #5]
        G03 X[#24 - #32] Y[#25 + #33 - #5] R#5
        G01 Y[#25 - #33 + #5]
        G03 X[#24 - #32 + #5] Y[#25 - #33] R#5
        G01 X[#24 + #32 - #5]

        #31 = #31 + 1
    END2

    (DESPEGAR EN Z AL PLANO SEGURO ANTES DEL SIGUIENTE NIVEL)
    G00 Z#2
END1

(RETIRADA A PLANO DE SEGURIDAD Z50)
G90 G00 Z50.0
GOTO9999

(MENSAJES DE ALARMA DE SEGURIDAD #3000)
N9101 #3000 = 101 (LONGITUD W INVALIDA)
N9102 #3000 = 102 (ANCHURA H INVALIDA)
N9103 #3000 = 103 (PROFUNDIDAD Z INVALIDA)
N9104 #3000 = 104 (DIAMETRO DE HERRAMIENTA INVALIDO)
N9105 #3000 = 105 (PASO EN Z K INVALIDO)
N9106 #3000 = 106 (RADIO DE HERRAMIENTA MAYOR O IGUAL AL RADIO DE ESQUINA R)
N9107 #3000 = 107 (FRESA O SOBREMATERIAL EXCEDEN LONGITUD W)
N9108 #3000 = 108 (FRESA O SOBREMATERIAL EXCEDEN ANCHURA H)
N9109 #3000 = 109 (AVANCE F DEBE SER MAYOR A CERO)
N9110 #3000 = 110 (VELOCIDAD DE HUSILLO S DEBE SER MAYOR A CERO)

N9999 G#10
M99
%
