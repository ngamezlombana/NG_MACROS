O1005 (RANURA CERRADA INCLINADA V2 - CLIMB MILLING CCW)

(========================================)
(--- VARIABLES DE ENTRADA DEL OPERARIO ---)
#20 = 1     (NUMERO DE HERRAMIENTA)
(========================================)
#1 = 100.0  (LONGITUD L ENTRE CENTROS DE LA RANURA)
#2 = 20.0   (RADIO DE LA RANURA - ANCHO TOTAL SERA EL DOBLE)
#3 = 0 (ANGULO DE INCLINACION EN GRADOS)
#4 = 12.0   (DIAMETRO DE LA HERRAMIENTA)
#5 = 15.0   (PROFUNDIDAD TOTAL Z FINAL - VALOR POSITIVO)
#6 = 5.0    (PROFUNDIDAD POR PASADA EN Z DESBASTE)
#7 = 0.5    (SOBREMATERIAL RADIAL PARA EL ACABADO)
#8 = 160.0  (Vc - VELOCIDAD DE CORTE EN m/min)
#9 = 4.0    (NUMERO DE INSERTOS O LABIOS)
#10 = 0.08  (fz - AVANCE POR INSERTO EN mm/rev)
#11 = 50.0  (PLANO DE SEGURIDAD RETROCESO R)
#12 = 0.0   (COORDENADA X DEL CENTRO DE LA RANURA)
#13 = 0.0   (COORDENADA Y DEL CENTRO DE LA RANURA)
#14 = 6.0   (PASO RADIAL MAXIMO DESBASTE XY)
#15 = -5.0  (Z INICIAL DE CORTE / REINICIO)
#16 = 4.0   (RADIO DEL ARCO ENTRADA Y SALIDA ACABADO)
#17 = 0.0   (OPCION: 0=AMBOS, 1=SOLO DESBASTE, 2=SOLO ACABADO)
(========================================)

(--- COMPROBACIONES DE SEGURIDAD BASICAS ---)
IF [[#4 / 2] GE #2] GOTO 9001
IF [#15 LE -#5] GOTO 9003
IF [#17 LT 0] GOTO 9005
IF [#17 GT 2] GOTO 9005

(--- CALCULOS DE PARAMETROS DE CORTE ---)
#100 = ROUND[[#8 * 1000] / [3.1416 * #4]] (CALCULO DE RPM)
#101 = ROUND[#100 * #9 * #10] (AVANCE NOMINAL)
#102 = #4 / 2 (RADIO DE LA HERRAMIENTA)

(--- CALCULOS DE GEOMETRIA MAXIMA ---)
#103 = #2 - #7 - #102 (RADIO MAXIMO DESBASTE)
IF [#103 LT 0] THEN #103 = 0 
#113 = #2 - #102 (RADIO MAXIMO ACABADO)
#104 = -#5 (Z FINAL EN COORDENADA NEGATIVA)

(--- TRIGONOMETRIA PRECALCULADA ---)
#130 = COS[#3]
#131 = SIN[#3]
#132 = #1 / 2 (MITAD DISTANCIA ENTRE CENTROS)

(--- CENTROS DE LOS ARCOS DE LA RANURA C1 Y C2 ---)
#141 = [#132 * #130] + #12 (C1 X - DERECHA)
#142 = [#132 * #131] + #13 (C1 Y)
#143 = [-#132 * #130] + #12 (C2 X - IZQUIERDA)
#144 = [-#132 * #131] + #13 (C2 Y)

(--- ENCABEZADO Y POSICIONAMIENTO ---)
T#20 M06 (LLAMAR HERRAMIENTA)
G90 G54 G17 G40 G80 G49
G00 X#12 Y#13 
G43 H#20 Z#11 (*** VERIFICAR CORRECTOR H ***)
S#100 M03
M08

G00 Z[#15 + 1.0]

IF [#17 EQ 2] GOTO 200

(========================================)
(       RUTINA DE DESBASTE (N100)        )
(========================================)
#105 = #15

N100 (--- BUCLE PROFUNDIDAD Z ---)
IF [#105 LE #104] GOTO 190
#105 = #105 - #6
IF [#105 LT #104] THEN #105 = #104

G00 X#12 Y#13
G01 Z#105 F[#101 / 2]

#120 = 0

N110 (--- BUCLE DE EXPANSION RADIAL ---)
IF [#120 GT 0] GOTO 115

(PASO CENTRAL)
G01 X#141 Y#142 F#101
G01 X#143 Y#144
G01 X#12 Y#13
GOTO 118

N115 (--- PASOS EXPANDIDOS CLIMB MILLING ---)
#151 = -#120 * #131 (dX PERPENDICULAR)
#152 = #120 * #130  (dY PERPENDICULAR)

#106 = ROUND[#101 * #120 / [#120 + #102]] 

#161 = #141 + #151 (P1: SUP DER)
#162 = #142 + #152
#163 = #143 + #151 (P2: SUP IZQ)
#164 = #144 + #152
#165 = #143 - #151 (P3: INF IZQ)
#166 = #144 - #152
#167 = #141 - #151 (P4: INF DER)
#168 = #142 - #152

#169 = #12 + #151 (M1: MEDIO SUPERIOR)
#170 = #13 + #152

(TRAZADO ANTIHORARIO CCW)
G01 X#169 Y#170 F#101 
G01 X#163 Y#164 (LINEA A P2)
G03 X#165 Y#166 I[-#151] J[-#152] F#106 (ARCO C2)
G01 X#167 Y#168 F#101 (LINEA A P4)
G03 X#161 Y#162 I[#151] J[#152] F#106 (ARCO C1)
G01 X#169 Y#170 F#101 (CIERRE EN M1)

N118
IF [#120 GE #103] GOTO 119
#120 = #120 + #14
IF [#120 GT #103] THEN #120 = #103
GOTO 110

N119 (*** LEVANTAMIENTO DE SEGURIDAD ***)
G00 Z#11
G00 X#12 Y#13
G00 Z[#105 + 1.0]

GOTO 100

N190 
IF [#17 EQ 1] GOTO 999 

(========================================)
(       RUTINA DE ACABADO (N200)         )
(========================================)
N200
G00 X#12 Y#13 
G01 Z#104 F[#101 / 2] 

#151 = -#113 * #131 
#152 = #113 * #130  
#169 = #12 + #151 (M1)
#170 = #13 + #152 

#133 = #16 * #130 
#134 = #16 * #131 
#135 = -#16 * #131 
#136 = #16 * #130 

(ENTRADA Y SALIDA TANGENCIAL CCW)
#171 = #169 + #133 - #135 
#172 = #170 + #134 - #136 
#173 = #169 - #133 - #135 
#174 = #170 - #134 - #136 

#161 = #141 + #151 (P1)
#162 = #142 + #152 
#163 = #143 + #151 (P2)
#164 = #144 + #152 
#165 = #143 - #151 (P3)
#166 = #144 - #152 
#167 = #141 - #151 (P4)
#168 = #142 - #152 

#116 = ROUND[#101 * #113 / [#113 + #102]] 

G01 X#171 Y#172 F#101 
G03 X#169 Y#170 I[-#133] J[-#134] F#116 (ARCO ENTRADA)
G01 X#163 Y#164 F#101
G03 X#165 Y#166 I[-#151] J[-#152] F#116 (ARCO C2)
G01 X#167 Y#168 F#101
G03 X#161 Y#162 I[#151] J[#152] F#116 (ARCO C1)
G01 X#169 Y#170 F#101
G03 X#173 Y#174 I[-#135] J[-#136] F#116 (ARCO SALIDA)

(*** LEVANTAMIENTO DE SEGURIDAD ***)
G00 Z#11
G00 X#12 Y#13

N999 
G00 Z#11
M09
M05
G28 G91 Z0.
G90
M30

N9001 #3000=1 (ERROR: HTA MAYOR QUE RANURA)
N9003 #3000=3 (ERROR: Z INICIAL INFERIOR A Z FINAL)
N9005 #3000=5 (ERROR: OPCION DE CICLO DEBE SER 0-1-2)
