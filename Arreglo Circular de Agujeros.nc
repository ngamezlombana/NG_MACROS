O1004 (PATRON CIRCULAR V5 - FLEXIBLE)

(========================================)
(--- VARIABLES DE ENTRADA DEL OPERARIO ---)
#20 = 1     (NUMERO DE HERRAMIENTA)
(========================================)
#1 = 150.0  (DIAMETRO DEL CIRCULO)
#2 = 12     (NUMERO TOTAL DE AGUJEROS DEL PATRON)
#3 = 10.0   (DIAMETRO DE LA BROCA)
#4 = 2500   (RPM)
#5 = 300.0  (AVANCE F)
#6 = 25.0   (PROFUNDIDAD TOTAL)
#7 = 1      (ESTRATEGIA: 0=DIRECTO, 1=PICOTEO)
#8 = 5.0    (PASO PICOTEO)
#9 = 5.0    (SEGURIDAD SOBRE PIEZA)
#10 = 0.0   (CENTRO X)
#11 = 0.0   (CENTRO Y)
#12 = 0.0   (Z INICIAL)
#13 = 0   (ANGULO INICIAL)
#14 = 1.0   (AGUJERO DE INICIO)
#15 = 12.0  (AGUJERO FINAL - EJ: 12 HACE HASTA EL ULTIMO)
(========================================)

(--- COMPROBACIONES Y AJUSTE DE RANGO ---)
IF [#2 LT 1] GOTO 9001
IF [#14 LT 1] GOTO 9006
(Si el usuario pide un final mayor al total, lo limitamos al total)
IF [#15 GT #2] THEN #15 = #2
IF [#14 GT #15] GOTO 9007

(--- CALCULOS ---)
#104 = #12 - #6 (FONDO Z)
#108 = #1 / 2   (RADIO PATRON)
#109 = #12 + #9 (PLANO SEGURIDAD)
#116 = 360 / #2 (GRADOS POR AGUJERO)

(--- INICIALIZACION ---)
#110 = #14 - 1      (INDICE ACTUAL INICIAL)
#117 = #15          (INDICE FINAL)

T#20 M06 (LLAMAR HERRAMIENTA)
G90 G54 G17 G40 G80 G49
S#4 M03
M08

N10 (--- BUCLE PRINCIPAL ---)
IF [#110 GE #117] GOTO 999

(CALCULO ANGULO Y POSICION)
#111 = #13 + [#110 * #116]
#112 = #10 + [#108 * COS[#111]]
#113 = #11 + [#108 * SIN[#111]]

G00 X#112 Y#113
G43 H#20 Z#109

(ESTRATEGIA)
IF [#7 EQ 1] GOTO 50

(DIRECTO)
G01 Z#104 F#5
G00 Z#109
GOTO 100

N50 (PICOTEO)
#106 = #12
N55
#107 = #106 - #8
IF [#107 LT #104] THEN #107 = #104
G00 Z[#106 + 1.0]
G01 Z#107 F#5
G00 Z#109
#106 = #107
IF [#106 GT #104] GOTO 55

N100
#110 = #110 + 1
GOTO 10

N999
G00 Z[#109 + 50.0]
M09 M05
G28 G91 Z0.
G90
M30

(--- ALARMAS ---)
N9001 #3000=1 (ERROR: TOTAL AGUJEROS < 1)
N9006 #3000=6 (ERROR: AGUJERO INICIO < 1)
N9007 #3000=7 (ERROR: AGUJERO INICIO > AGUJERO FINAL)
