%
O8107 (ACABADO DE CAJERA CIRCULAR)
(PETER SMID - FANUC CNC CUSTOM MACROS - CAPITULO 20)
(LLAMADA G65: G65 P8107 X.. Y.. Z.. W.. T.. F..)

(VARIABLES DE ENTRADA DEL OPERARIO)
#24 = 0.0    (X: COORDENADA X DEL CENTRO DE LA CAJERA)
#25 = 0.0    (Y: COORDENADA Y DEL CENTRO DE LA CAJERA)
#26 = 15.0   (Z: PROFUNDIDAD TERMINADA DE LA CAJERA)
#23 = 80.0   (W: DIAMETRO FINAL TERMINADO)
#20 = 5.0    (T: RADIO DE LA HERRAMIENTA O CORRECTOR)
#9  = 250.0  (F: AVANCE DE CORTE DE ACABADO EN MM/MIN)

(CONTROL DE ERRORES Y SEGURIDAD)
IF [#23 LE 0] GOTO9101
IF [#20 LE 0] GOTO9102
IF [#26 LE 0] GOTO9103
IF [#9 LE 0] GOTO9104

#10 = #4003
#18 = #23 / 2.0 (RADIO DE LA CAJERA)
IF [#20 GE #18] GOTO9105 (HERRAMIENTA EXCEDE RADIO DE CAJERA)

(CALCULO DE RADIO DE CORTE Y ARCO DE ENTRADA/SALIDA TANGENCIAL)
#4 = #18 - #20 (RADIO DE TRAYECTORIA DEL CENTRO DE HERRAMIENTA)
#32 = #4 / 2.0 (RADIO DEL ARCO DE ENTRADA Y SALIDA TANGENCIAL)

(POSICIONAMIENTO AL CENTRO Y APROXIMACION Z)
G90 G00 X#24 Y#25
G00 Z2.0
G01 Z-[#26] F[#9 / 2.0]

(APROXIMACION EN ARCO TANGENCIAL CON COMPENSACION DE RADIO G41)
G91 G01 G41 X#32 Y#32 D20 F#9
G03 X-[#32] Y#32 I-[#32] J0 F#9

(MECANIZADO PERIMETRAL CIRCULAR COMPLETO 360 GRADOS)
G03 I0 J-[#4]

(SALIDA EN ARCO TANGENCIAL HACIA EL CENTRO)
G03 X-[#32] Y-[#32] I0 J-[#32]
G01 G40 X#32 Y-[#32] F[#9 * 2.0]

(RETIRADA A PLANO DE SEGURIDAD EN MODO ABSOLUTO)
G90 G00 Z5.0
GOTO9999

(MENSAJES DE ALARMA DE SEGURIDAD #3000)
N9101 #3000 = 101 (DIAMETRO DE LA CAJERA DEBE SER MAYOR A CERO)
N9102 #3000 = 102 (RADIO DE HERRAMIENTA T DEBE SER MAYOR A CERO)
N9103 #3000 = 103 (PROFUNDIDAD Z DEBE SER MAYOR A CERO)
N9104 #3000 = 104 (AVANCE F DEBE SER MAYOR A CERO)
N9105 #3000 = 105 (RADIO HERRAMIENTA EXCEDE RADIO DE LA CAJERA)

N9999 G#10
M99
%
