%
O8107 (ACABADO DE CAJERA CIRCULAR)
(INGENIERO NESTOR GAMEZ - FANUC CNC CUSTOM MACROS)
(LLAMADA G65: G65 P8107 X.. Y.. W.. T.. F.. S.. Z.. R..)

(VARIABLES DE ENTRADA DEL OPERARIO)
(1. DIMENSIONES GEOMETRICAS)
#24 = 0.0    (X: COORDENADA X DEL CENTRO DE LA CAJERA)
#25 = 0.0    (Y: COORDENADA Y DEL CENTRO DE LA CAJERA)
#23 = 80.0   (W: DIAMETRO FINAL TERMINADO)

(2. CONDICIONES DE CORTE Y HERRAMIENTA)
#20 = 10.0   (T: DIAMETRO DE LA FRESA DE ACABADO)
#9  = 250.0  (F: AVANCE DE CORTE DE ACABADO EN MM/MIN)
#19 = 2200.0 (S: VELOCIDAD DEL HUSILLO EN RPM)

(3. ESTRATEGIA DE MECANIZADO Y SEGURIDAD)
#26 = 15.0   (Z: PROFUNDIDAD TERMINADA DE LA CAJERA)
#18 = 2.0    (R: PLANO DE SEGURIDAD EN Z)

(CONTROL DE ERRORES Y SEGURIDAD)
IF [#23 LE 0] GOTO9101
IF [#20 LE 0] GOTO9102
IF [#26 LE 0] GOTO9103
IF [#9 LE 0] GOTO9104
IF [#19 LE 0] GOTO9106
IF [#18 LT 0] #18 = 2.0

#10 = #4003
#14 = #23 / 2.0 (RADIO DE LA CAJERA)
#15 = #20 / 2.0 (RADIO DE LA FRESA)
IF [#15 GE #14] GOTO9105

#4 = #14 - #15 (RADIO DE TRAYECTORIA DEL CENTRO DE HERRAMIENTA)
#32 = #4 / 2.0 (RADIO DEL ARCO DE ENTRADA Y SALIDA)

(ARRANQUE DE HUSILLO Y POSICIONAMIENTO)
G90 G00 S#19 M03
G00 X#24 Y#25
G00 Z#18
G01 Z-[#26] F[#9 / 2.0]

(ENTRADA EN ARCO TANGENCIAL DESDE EL CENTRO)
G91 G03 X#4 I#32 J0 F#9

(MECANIZADO PERIMETRAL CIRCULAR COMPLETO 360 GRADOS)
G03 I-[#4]

(SALIDA EN ARCO TANGENCIAL HACIA EL CENTRO)
G03 X-[#4] I-[#32] J0

(RETIRADA A PLANO DE SEGURIDAD EN MODO ABSOLUTO)
G90 G00 Z25.0
GOTO9999

(MENSAJES DE ALARMA DE SEGURIDAD #3000)
N9101 #3000 = 101 (DIAMETRO DE LA CAJERA DEBE SER MAYOR A CERO)
N9102 #3000 = 102 (DIAMETRO DE HERRAMIENTA T DEBE SER MAYOR A CERO)
N9103 #3000 = 103 (PROFUNDIDAD Z DEBE SER MAYOR A CERO)
N9104 #3000 = 104 (AVANCE F DEBE SER MAYOR A CERO)
N9105 #3000 = 105 (HERRAMIENTA EXCEDE RADIO DE LA CAJERA)
N9106 #3000 = 106 (VELOCIDAD DE HUSILLO S DEBE SER MAYOR A CERO)

N9999 G#10
M99
%
