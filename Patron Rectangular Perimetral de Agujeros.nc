O1008 (PATRON RECTANGULAR PERIMETRAL DE AGUJEROS V2)

(========================================)
(--- VARIABLES DE ENTRADA DEL OPERARIO ---)
#20 = 1     (NUMERO DE HERRAMIENTA)
(========================================)
#1 = 150.0  (LONGITUD TOTAL X DEL MARCO)
#2 = 100.0  (ANCHO TOTAL Y DEL MARCO)
#3 = 2      (CANTIDAD AGUJEROS EN X)
#4 = 2      (CANTIDAD AGUJEROS EN Y)
#5 = 2500   (RPM)
#6 = 300.0  (AVANCE F)
#7 = 20.0   (PROFUNDIDAD Z TOTAL)
#8 = 1      (ESTRATEGIA: 0=DIRECTO, 1=PICOTEO)
#9 = 5.0    (PASO PICOTEO)
#10 = 5.0   (SEGURIDAD Z)
#11 = 0.0   (CENTRO X)
#12 = 0.0   (CENTRO Y)
#13 = 0.0   (Z INICIAL)
(========================================)

(--- COMPROBACIONES DE SEGURIDAD ---)
IF [#3 LT 2] GOTO 9001
IF [#4 LT 2] GOTO 9001
IF [#8 NE 1] GOTO 25
IF [#9 LE 0] GOTO 9002
N25

(--- CALCULOS ---)
#100 = #13 - #7       (FONDO Z)
#101 = #13 + #10      (PLANO SEGURIDAD)
#102 = #1 / [#3 - 1]  (PASO ENTRE AGUJEROS X)
#103 = #2 / [#4 - 1]  (PASO ENTRE AGUJEROS Y)
#104 = #11 - [#1 / 2] (INICIO X)
#105 = #12 - [#2 / 2] (INICIO Y)
#115 = [2 * #3] + [2 * #4] - 4 (CANTIDAD TOTAL DE AGUJEROS)

T#20 M06 (LLAMAR HERRAMIENTA)
G90 G54 G17 G40 G80 G49
(--- LLAMADO REPLAZADO POR T#20 ---)  (T01 M06 (Selecciona herramienta 1))
S#5 M03 M08

#110 = 0 (INDICE ACTUAL DEL AGUJERO, DE 0 A N_TOTAL - 1)

N10 (--- BUCLE PRINCIPAL DE AGUJEROS ---)
IF [#110 GE #115] GOTO 999

(--- CALCULAR COORDENADAS X E Y PARA EL AGUJERO ACTUAL ---)
(LADO 1: INFERIOR - IZQ A DER)
IF [#110 GE #3] GOTO 20
    #112 = #104 + [#110 * #102]
    #113 = #105
    GOTO 100

N20 (LADO 2: DERECHO - ABAJO A ARRIBA - SIN ESQUINAS)
#116 = #3 + #4 - 2
IF [#110 GE #116] GOTO 30
    #120 = #110 - #3 + 1
    #112 = #104 + #1
    #113 = #105 + [#120 * #103]
    GOTO 100

N30 (LADO 3: SUPERIOR - DER A IZQ)
#117 = [2 * #3] + #4 - 2
IF [#110 GE #117] GOTO 40
    #120 = #110 - #116
    #112 = #104 + [[#3 - 1 - #120] * #102]
    #113 = #105 + #2
    GOTO 100

N40 (LADO 4: IZQUIERDO - ARRIBA A ABAJO - SIN ESQUINAS)
    #120 = #110 - #117
    #112 = #104
    #113 = #105 + [[#4 - 2 - #120] * #103]

N100 (--- EJECUTAR TALADRADO EN COORDENADAS CALCULADAS ---)
G00 X#112 Y#113
G43 H#20 Z#101 (*** VERIFICAR CORRECTOR DE ALTURA H ***)

(ESTRATEGIA DE TALADRADO)
IF [#8 EQ 1] GOTO 600

(TALADRADO DIRECTO)
G01 Z#100 F#6
G00 Z#101
GOTO 200

N600 (TALADRADO CON PICOTEO)
#106 = #13 (INICIALIZAR Z PARA PICOTEO)
N605
#107 = #106 - #9 (SIGUIENTE PASO DE PROFUNDIDAD)
IF [#107 LT #100] THEN #107 = #100 (LIMITAR AL FONDO Z)
G00 Z[#106 + 1.0] (ACERCAMIENTO RAPIDO CON RETROCESO DE 1MM)
G01 Z#107 F#6 (AVANCE DE CORTE)
G00 Z#101 (RETROCESO AL PLANO DE SEGURIDAD)
#106 = #107
IF [#106 GT #100] GOTO 605 (REPETIR HASTA LLEGAR AL FONDO)

N200 (--- PREPARAR SIGUIENTE AGUJERO ---)
#110 = #110 + 1
GOTO 10

N999 (--- FIN DE MECANIZADO ---)
G00 Z[#101 + 50.0]
M09 M05
G28 G91 Z0.
G90
M30

(--- ALARMAS ---)
N9001 #3000=1 (ERROR: MINIMO 2 AGUJEROS POR LADO)
N9002 #3000=2 (ERROR: PICOTEO INVALIDO)
