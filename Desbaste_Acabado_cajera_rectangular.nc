O1004 (CAJA RECTANGULAR DESBASTE Y ACABADO V3)

(========================================)
(--- VARIABLES DE ENTRADA DEL OPERARIO ---)
(========================================)
#1 = 120.0  (LONGITUD X DE LA CAJA)
#2 = 80.0   (ANCHO Y DE LA CAJA)
#3 = 15.0   (RADIO EN LAS ESQUINAS DE LA PIEZA)
#4 = 12.0   (DIAMETRO DE LA HERRAMIENTA)
#5 = 20.0   (PROFUNDIDAD TOTAL Z FINAL - VALOR POSITIVO)
#6 = 5.0    (PROFUNDIDAD POR PASADA EN Z DESBASTE)
#7 = 0.5    (SOBREMATERIAL RADIAL PARA EL ACABADO)
#8 = 160.0  (Vc - VELOCIDAD DE CORTE EN m/min)
#9 = 4.0    (NUMERO DE INSERTOS O LABIOS)
#10 = 0.08  (fz - AVANCE POR INSERTO EN mm/rev)
#11 = 50.0  (PLANO DE SEGURIDAD RETROCESO R)
#12 = 0.0   (CENTRO DE LA CAJA EN X)
#13 = 0.0   (CENTRO DE LA CAJA EN Y)
#14 = 8.0   (PASO RADIAL MAXIMO DESBASTE XY)
#15 = -5.0  (Z INICIAL DE CORTE / REINICIO)
#16 = 5.0   (RADIO DEL ARCO ENTRADA Y SALIDA ACABADO)
#17 = 2.0   (OPCION: 0=AMBOS, 1=SOLO DESBASTE, 2=SOLO ACABADO)
(========================================)

(--- COMPROBACIONES DE SEGURIDAD BASICAS ---)
IF [#4 GE #1] GOTO 9001
IF [#4 GE #2] GOTO 9001
IF [[#4 / 2] GT #3] GOTO 9002
IF [#15 LE -#5] GOTO 9003
IF [#17 LT 0] GOTO 9005
IF [#17 GT 2] GOTO 9005

(--- CALCULOS DE PARAMETROS DE CORTE ---)
#100 = ROUND[[#8 * 1000] / [3.1416 * #4]] (CALCULO DE RPM)
#101 = ROUND[#100 * #9 * #10] (AVANCE LINEAL NOMINAL F)
#102 = #4 / 2 (RADIO DE LA HERRAMIENTA)

(--- GEOMETRIA MAXIMA DE DESBASTE ---)
#103 = [#1 / 2] - #7 - #102 (DIST. MAX X DESBASTE)
#104 = [#2 / 2] - #7 - #102 (DIST. MAX Y DESBASTE)
#105 = #3 - #7 - #102 (RADIO TRAYECTORIA ESQUINA DESBASTE)
IF [#105 LT 0] THEN #105 = 0

(--- GEOMETRIA MAXIMA DE ACABADO ---)
#113 = [#1 / 2] - #102 (DIST. MAX X ACABADO)
#114 = [#2 / 2] - #102 (DIST. MAX Y ACABADO)
#115 = #3 - #102 (RADIO TRAYECTORIA ESQUINA ACABADO)
IF [#115 LT 0] THEN #115 = 0

(--- CALCULO PROPORCIONAL PARA DESBASTE ---)
#106 = #103
IF [#104 GT #103] THEN #106 = #104
IF [#106 LE 0] THEN #106 = 0.001 
#107 = ROUND[#101 * #105 / [#105 + #102]] (AVANCE COMPENSADO ARCOS DESBASTE)
#108 = -#5 (Z FINAL EN COORDENADA NEGATIVA)

(--- ENCABEZADO DE MAQUINA Y POSICIONAMIENTO ---)
G90 G54 G17 G40 G80 G49
G00 X#12 Y#13 
G43 H2 Z#11 (*** VERIFICAR CORRECTOR DE ALTURA H ***)
S#100 M03
M08

G00 Z[#15 + 1.0]

IF [#17 EQ 2] GOTO 200

(========================================)
(       RUTINA DE DESBASTE (N100)        )
(========================================)
#109 = #15 

N100 
IF [#109 LE #108] GOTO 190
#109 = #109 - #6
IF [#109 LT #108] THEN #109 = #108

G00 X#12 Y#13 
G01 Z#109 F[#101 / 2] 

#120 = 0 

N110 (--- BUCLE RADIAL XY ---)
#120 = #120 + #14 
#121 = #120 / #106 
IF [#121 LT 1.0] GOTO 115
#121 = 1.0 

N115
#122 = #103 * #121 
#123 = #104 * #121 
#124 = #105 * #121 

(TRAZADO DESBASTE CLIMB MILLING CCW)
G01 X[#12] Y[#13 + #123] F#101 (CENTRO BORDE SUPERIOR)
G01 X[#12 - #122 + #124] (HACIA ESQ. SUP-IZQ)
IF [#124 LE 0.001] GOTO 21
G03 X[#12 - #122] Y[#13 + #123 - #124] I0. J-[#124] F#107
GOTO 22
N21 G01 X[#12 - #122] Y[#13 + #123]

N22 G01 Y[#13 - #123 + #124] F#101 (HACIA ESQ. INF-IZQ)
IF [#124 LE 0.001] GOTO 23
G03 X[#12 - #122 + #124] Y[#13 - #123] I[#124] J0. F#107
GOTO 24
N23 G01 X[#12 - #122] Y[#13 - #123]

N24 G01 X[#12 + #122 - #124] F#101 (HACIA ESQ. INF-DER)
IF [#124 LE 0.001] GOTO 25
G03 X[#12 + #122] Y[#13 - #123 + #124] I0. J[#124] F#107
GOTO 26
N25 G01 X[#12 + #122] Y[#13 - #123]

N26 G01 Y[#13 + #123 - #124] F#101 (HACIA ESQ. SUP-DER)
IF [#124 LE 0.001] GOTO 27
G03 X[#12 + #122 - #124] Y[#13 + #123] I-[#124] J0. F#107
GOTO 28
N27 G01 X[#12 + #122] Y[#13 + #123]

N28 G01 X[#12] F#101 

IF [#121 LT 1.0] GOTO 110 

(*** LEVANTAMIENTO DE SEGURIDAD ***)
G00 Z#11 
G00 X#12 Y#13 
G00 Z[#109 + 1.0] 

GOTO 100 

N190 
IF [#17 EQ 1] GOTO 999 

(========================================)
(       RUTINA DE ACABADO (N200)         )
(========================================)
N200
G00 X#12 Y#13 
G01 Z#108 F[#101 / 2] 

#116 = ROUND[#101 * #115 / [#115 + #102]] 

(PREPARACION Y ENTRADA TANGENCIAL)
G01 X[#12 - #16] Y[#13 - #114 + #16] F#101
G03 X[#12] Y[#13 - #114] I[#16] J0. F#116

(RECORRIDO PERIMETRAL CCW - INICIA HACIA LA DERECHA)
G01 X[#12 + #113 - #115] F#101 (HACIA ESQ. INF-DER)
IF [#115 LE 0.001] GOTO 31
G03 X[#12 + #113] Y[#13 - #114 + #115] I0. J[#115] F#116
GOTO 32
N31 G01 X[#12 + #113] Y[#13 - #114]

N32 G01 Y[#13 + #114 - #115] F#101 (HACIA ESQ. SUP-DER)
IF [#115 LE 0.001] GOTO 33
G03 X[#12 + #113 - #115] Y[#13 + #114] I-[#115] J0. F#116
GOTO 34
N33 G01 X[#12 + #113] Y[#13 + #114]

N34 G01 X[#12 - #113 + #115] F#101 (HACIA ESQ. SUP-IZQ)
IF [#115 LE 0.001] GOTO 35
G03 X[#12 - #113] Y[#13 + #114 - #115] I0. J-[#115] F#116
GOTO 36
N35 G01 X[#12 - #113] Y[#13 + #114]

N36 G01 Y[#13 - #114 + #115] F#101 (HACIA ESQ. INF-IZQ)
IF [#115 LE 0.001] GOTO 37
G03 X[#12 - #113 + #115] Y[#13 - #114] I[#115] J0. F#116
GOTO 38
N37 G01 X[#12 - #113] Y[#13 - #114]

N38 G01 X[#12] F#101 (RETORNO A CENTRO BORDE INFERIOR)

(SALIDA TANGENCIAL)
G03 X[#12 + #16] Y[#13 - #114 + #16] I0. J[#16]

(*** LEVANTAMIENTO DE SEGURIDAD ***)
G00 Z#11
G00 X#12 Y#13

N999 
G00 Z#11
M09
M05
G28 G91 Z0.
G90
M30

(--- ALARMAS Y ERRORES ---)
N9001 #3000=1 (ERROR: HTA MAYOR QUE CAJA)
N9002 #3000=2 (ERROR: RADIO HTA MAYOR A RADIO ESQUINA)
N9003 #3000=3 (ERROR: Z INICIAL INFERIOR A Z FINAL)
N9005 #3000=5 (ERROR: OPCION CICLO 0-1-2)