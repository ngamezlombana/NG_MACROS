%
O8111 (CICLO DE CORTE CIRCULAR G13)
(PETER SMID - FANUC CNC CUSTOM MACROS - CAPITULO 21)
(LLAMADA G65: G65 P8111 D.. T.. F.. O G13 D.. T.. F..)

(VARIABLES DE ENTRADA DEL OPERARIO)
#7  = 60.0   (D: DIAMETRO DE LA CAJERA CIRCULAR)
#20 = 6.0    (T: RADIO DE LA FRESA O NUMERO DE COMPENSACION)
#9  = 300.0  (F: VELOCIDAD DE AVANCE DE CORTE EN MM/MIN)

(CONTROL DE ERRORES Y SEGURIDAD)
IF [#7 LE 0] GOTO9101
IF [#20 LE 0] GOTO9102
IF [#9 LE 0] GOTO9103

#11 = #4001 (GUARDA CODIGO G GRUPO 1)
#13 = #4003 (GUARDA CODIGO G GRUPO 3)

#31 = ABS[#7] / 2.0 (RADIO DE LA CAJERA)
#32 = #31 - #20     (RADIO DEL DESPLAZAMIENTO EFECTIVO)
IF [#32 LE 0] GOTO9104

#33 = #32 / 2.0     (RADIO DEL ARCO DE ENTRADA Y SALIDA)

(CICLO G13: FRESADO EN CONCORDANCIA / CLIMB MILLING)
(1. ARCO DE ENTRADA TANGENCIAL DESDE EL CENTRO)
G91 G03 X#32 I#33 J0 F#9

(2. INTERPOLACION CIRCULAR COMPLETA 360 GRADOS)
G03 I-[#32]

(3. ARCO DE SALIDA TANGENCIAL DE REGRESO AL CENTRO)
G03 X-[#32] I-[#33] J0

(RESTAURA CONDICIONES MODALES ANTERIORES)
G#11 G#13
GOTO9999

(MENSAJES DE ALARMA DE SEGURIDAD #3000)
N9101 #3000 = 101 (DIAMETRO D DEBE SER MAYOR A CERO)
N9102 #3000 = 102 (RADIO DE HERRAMIENTA T DEBE SER MAYOR A CERO)
N9103 #3000 = 103 (AVANCE F DEBE SER MAYOR A CERO)
N9104 #3000 = 104 (RADIO DE HERRAMIENTA EXCEDE RADIO DE LA CAJERA)

N9999 M99
%
