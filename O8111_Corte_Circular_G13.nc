%
O8111 (CICLO DE CORTE CIRCULAR G13 - EMULACION CON G03)
(INGENIERO NESTOR GAMEZ - FANUC CNC CUSTOM MACROS)
(LLAMADA G65: G65 P8111 X.. Y.. D.. T.. F.. S.. Z.. R..)
(NOTA: G13 NO ES UN CICLO ESTANDAR EN TODOS LOS CONTROLES;)
(ESTA MACRO EMULA SU TRAYECTORIA CON MOVIMIENTOS G03.)

(VARIABLES DE ENTRADA DEL OPERARIO)
(1. DIMENSIONES GEOMETRICAS)
#24 = 0.0    (X: COORDENADA X DEL CENTRO DE LA CAJERA)
#25 = 0.0    (Y: COORDENADA Y DEL CENTRO DE LA CAJERA)
#7  = 60.0   (D: DIAMETRO DE LA CAJERA CIRCULAR)

(2. CONDICIONES DE CORTE Y HERRAMIENTA)
#20 = 12.0   (T: DIAMETRO DE LA FRESA DE CORTE)
#9  = 300.0  (F: VELOCIDAD DE AVANCE DE CORTE EN MM/MIN)
#19 = 2000.0 (S: VELOCIDAD DEL HUSILLO EN RPM)

(3. ESTRATEGIA DE MECANIZADO Y SEGURIDAD)
#26 = 12.0   (Z: PROFUNDIDAD DE LA CAJERA)
#18 = 2.0    (R: PLANO DE SEGURIDAD EN Z)

(CONTROL DE ERRORES Y SEGURIDAD)
IF [#7 LE 0] GOTO9101
IF [#20 LE 0] GOTO9102
IF [#9 LE 0] GOTO9103
IF [#26 LE 0] GOTO9105
IF [#19 LE 0] GOTO9106
IF [#18 LT 0] #18 = 2.0

#11 = #4001
#13 = #4003

#31 = ABS[#7] / 2.0
#15 = #20 / 2.0
#32 = #31 - #15
IF [#32 LE 0] GOTO9104

#33 = #32 / 2.0

(ARRANQUE DE HUSILLO Y POSICIONAMIENTO AL FONDO)
G90 G00 S#19 M03
G00 X#24 Y#25
G00 Z#18
G01 Z-[#26] F[#9 / 2.0]

(CICLO G13: FRESADO EN CONCORDANCIA / CLIMB MILLING)
G91 G03 X#32 I#33 J0 F#9
G03 I-[#32]
G03 X-[#32] I-[#33] J0

(RESTAURA CONDICIONES Y RETIRO)
G90 G00 Z25.0
G#11 G#13
GOTO9999

(MENSAJES DE ALARMA DE SEGURIDAD #3000)
N9101 #3000 = 101 (DIAMETRO D DEBE SER MAYOR A CERO)
N9102 #3000 = 102 (DIAMETRO DE HERRAMIENTA T DEBE SER MAYOR A CERO)
N9103 #3000 = 103 (AVANCE F DEBE SER MAYOR A CERO)
N9104 #3000 = 104 (HERRAMIENTA EXCEDE RADIO DE LA CAJERA)
N9105 #3000 = 105 (PROFUNDIDAD Z DEBE SER MAYOR A CERO)
N9106 #3000 = 106 (VELOCIDAD DE HUSILLO S DEBE SER MAYOR A CERO)

N9999 M99
%
