%
O8109 (RANURA CIRCULAR CON PROFUNDIDAD MULTIPLE)
(PETER SMID - FANUC CNC CUSTOM MACROS - CAPITULO 20)
(LLAMADA G65: G65 P8109 X.. Y.. W.. D.. C.. F..)

(VARIABLES DE ENTRADA DEL OPERARIO)
#24 = 0.0    (X: COORDENADA X DEL CENTRO DE LA RANURA)
#25 = 0.0    (Y: COORDENADA Y DEL CENTRO DE LA RANURA)
#23 = 90.0   (W: DIAMETRO DE PASO CENTRAL DE LA RANURA)
#7  = 10.0   (D: PROFUNDIDAD TOTAL DE LA RANURA)
#3  = 2.0    (C: PROFUNDIDAD MAXIMA POR PASADA EN Z)
#9  = 350.0  (F: VELOCIDAD DE AVANCE DE CORTE EN MM/MIN)

(CONTROL DE ERRORES Y SEGURIDAD)
IF [#23 LE 0] GOTO9101
IF [#7 LE 0]  GOTO9102
IF [#3 LE 0]  GOTO9103
IF [#9 LE 0]  GOTO9104

#11 = #4001 (GUARDA G-CODE GRUPO 1)
#13 = #4003 (GUARDA G-CODE GRUPO 3)

#18 = #23 / 2.0 (RADIO DE LA TRAYECTORIA CIRCULAR)

(POSICIONAMIENTO RAPIDO AL PUNTO DE INICIO SOBRE EL RADIO)
G90 G00 X[#24 + #18] Y#25
G00 Z2.0

(CALCULO DE CANTIDAD DE PASADAS ENTERAS)
#100 = #7 / #3
#101 = FIX[#100]

(BUCLE DE PASADAS DE PROFUNDIDAD EN Z)
#33 = 1
WHILE [#33 LE #101] DO1
  G91 G01 Z-[#3] F#9
  G03 I-[#18]
  #33 = #33 + 1
END1

(PASADA FINAL DE LIMPIEZA SI QUEDA REMANENTE DE PROFUNDIDAD)
IF [#100 EQ #101] GOTO900
#102 = #7 - [#101 * #3]
G91 G01 Z-[#102] F#9
G03 I-[#18]

N900 (RETIRADA RAPIDA A PLANO DE SEGURIDAD)
G90 G00 Z5.0
G#11 G#13
GOTO9999

(MENSAJES DE ALARMA DE SEGURIDAD #3000)
N9101 #3000 = 101 (DIAMETRO DE RANURA W DEBE SER MAYOR A CERO)
N9102 #3000 = 102 (PROFUNDIDAD TOTAL D DEBE SER MAYOR A CERO)
N9103 #3000 = 103 (PASO EN Z C DEBE SER MAYOR A CERO)
N9104 #3000 = 104 (AVANCE F DEBE SER MAYOR A CERO)

N9999 M99
%
