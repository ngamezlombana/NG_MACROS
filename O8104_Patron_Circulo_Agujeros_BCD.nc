%
O8104 (PATRON DE CIRCULO DE AGUJEROS PERNO BCD)
(INGENIERO NESTOR GAMEZ - FANUC CNC CUSTOM MACROS)
(LLAMADA G65: G65 P8104 X.. Y.. W.. H.. A.. S.. T.. F.. Z.. R.. E.. B..)

(VARIABLES DE ENTRADA DEL OPERARIO)
(1. DIMENSIONES GEOMETRICAS)
#24 = 0.0    (X: COORDENADA X DEL CENTRO DEL CIRCULO)
#25 = 0.0    (Y: COORDENADA Y DEL CENTRO DEL CIRCULO)
#23 = 120.0  (W: DIAMETRO DEL CIRCULO DE PASO BCD / PCD)
#11 = 8.0    (H: CANTIDAD TOTAL DE AGUJEROS EQUIESPACIADOS)
#1  = 0.0    (A: ANGULO DEL PRIMER AGUJERO DESDE EJE X+)
#19 = 1.0    (S: NUMERO DEL AGUJERO INICIAL A TALADRAR)

(2. CONDICIONES DE CORTE Y HERRAMIENTA)
#20 = 12.0   (T: DIAMETRO DE LA BROCA / HERRAMIENTA)
#9  = 280.0  (F: AVANCE DE TALADRADO EN MM/MIN)
#2  = 1200.0 (B: VELOCIDAD DEL HUSILLO EN RPM)

(3. ESTRATEGIA DE PERFORADO Y SEGURIDAD)
#26 = 25.0   (Z: PROFUNDIDAD TOTAL DE PERFORACION)
#18 = 3.0    (R: PLANO DE RETROCESO Y SEGURIDAD)
#8  = 6.0    (E: PASO DE PICOTEO EN Z PARA G83)

(CONTROL DE ERRORES Y SEGURIDAD)
IF [#23 LE 0] GOTO9101
IF [#11 NE FUP[#11]] GOTO9102
IF [#11 LE 0] GOTO9103
IF [#19 EQ #0] THEN #19 = 1.0
IF [#19 NE FUP[#19]] GOTO9102
IF [#19 LT 1] GOTO9104
IF [#19 GT #11] GOTO9105
IF [#26 LE 0] GOTO9106
IF [#9 LE 0] GOTO9107
IF [#2 LE 0] GOTO9108
IF [#20 LE 0] GOTO9109
IF [#8 LE 0] GOTO9110
IF [#18 LT 0] #18 = 3.0

(GUARDA ESTADO PREVIO DE G90/G91)
#10 = #4003

(CONSTANTES DE GEOMETRIA CIRCULAR)
#14 = #23 / 2.0       (RADIO DEL CIRCULO DE PASO)
#17 = 360.0 / #11     (PASO ANGULAR ENTRE AGUJEROS)

(CALCULO DE POSICION DEL AGUJERO INICIAL)
#30 = #1 + [[#19 - 1.0] * #17]
#31 = #24 + [#14 * COS[#30]]
#32 = #25 + [#14 * SIN[#30]]
#33 = #19             (CONTADOR DE AGUJERO ACTUAL)

(ARRANQUE DE HUSILLO Y APROXIMACION SEGURA)
S#2 M03 M08
G90 G00 X#31 Y#32
G00 Z50.0             (PLANO SEGURO INICIAL)
G00 Z#18              (PLANO DE RETROCESO R)

(TALADRADO DEL AGUJERO INICIAL CON G83)
G99 G83 X#31 Y#32 Z-[#26] R#18 Q#8 F#9

(BUCLE PARA LOS AGUJEROS RESTANTES EN G90 ABSOLUTO)
WHILE [#33 LT #11] DO1
  #33 = #33 + 1.0
  #30 = #1 + [[#33 - 1.0] * #17]
  #31 = #24 + [#14 * COS[#30]]
  #32 = #25 + [#14 * SIN[#30]]
  X#31 Y#32
END1

G80                   (CANCELAR CICLO FIJO)
G90 G00 Z50.0         (SUBIR A ALTURA SEGURA)
GOTO9999

(MENSAJES DE ALARMA DE SEGURIDAD #3000)
N9101 #3000 = 101 (DIAMETRO BCD DEBE SER MAYOR A CERO)
N9102 #3000 = 102 (CANTIDAD DE AGUJEROS DEBE SER ENTERO)
N9103 #3000 = 103 (NUMERO DE AGUJEROS DEBE SER MAYOR A CERO)
N9104 #3000 = 104 (AGUJERO DE INICIO S DEBE SER AL MENOS 1)
N9105 #3000 = 105 (AGUJERO DE INICIO S NO PUEDE SUPERAR TOTAL H)
N9106 #3000 = 106 (PROFUNDIDAD Z DEBE SER MAYOR A CERO)
N9107 #3000 = 107 (AVANCE F DEBE SER MAYOR A CERO)
N9108 #3000 = 108 (VELOCIDAD DE HUSILLO B DEBE SER MAYOR A CERO)
N9109 #3000 = 109 (DIAMETRO DE HERRAMIENTA T DEBE SER MAYOR A CERO)
N9110 #3000 = 110 (PASO DE PICOTEO E DEBE SER MAYOR A CERO)

N9999 G#10
M99
%
