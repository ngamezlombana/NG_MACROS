%
O8108 (MECANIZADO DE RANURA RECTA ANGULAR)
(INGENIERO NESTOR GAMEZ - FANUC CNC CUSTOM MACROS)
(LLAMADA G65: G65 P8108 X.. Y.. A.. D.. R.. T.. F.. S.. Z.. B..)

(VARIABLES DE ENTRADA DEL OPERARIO)
(1. DIMENSIONES GEOMETRICAS)
#24 = 30.0   (X: COORDENADA X CENTRO INICIAL RANURA)
#25 = 25.0   (Y: COORDENADA Y CENTRO INICIAL RANURA)
#1  = 25.0   (A: ORIENTACION ANGULAR EN GRADOS DESDE X+)
#7  = 60.0   (D: DISTANCIA ENTRE CENTROS EXTREMOS)
#18 = 10.0   (R: RADIO NOMINAL DE LA RANURA - ANCHO TOTAL 2R)

(2. CONDICIONES DE CORTE Y HERRAMIENTA)
#20 = 10.0   (T: DIAMETRO DE LA FRESA DE CORTE)
#9  = 300.0  (F: VELOCIDAD DE AVANCE DE CORTE EN MM/MIN)
#19 = 1600.0 (S: VELOCIDAD DEL HUSILLO EN RPM)

(3. ESTRATEGIA DE MECANIZADO Y SEGURIDAD)
#26 = 6.0    (Z: PROFUNDIDAD TOTAL DE LA RANURA)
#2  = 2.0    (B: PLANO DE SEGURIDAD EN Z)

(CONTROL DE ERRORES Y SEGURIDAD)
IF [#7 LE 0]  GOTO9101
IF [#18 LE 0] GOTO9102
IF [#20 LE 0] GOTO9103
IF [#26 LE 0] GOTO9104
IF [#9 LE 0]  GOTO9105
IF [#19 LE 0] GOTO9107
IF [#2 EQ 0] #2 = 2.0

#10 = #4003
#15 = #20 / 2.0 (RADIO DE LA FRESA)
IF [#15 GE #18] GOTO9106 (LA HERRAMIENTA NO CABE EN LA RANURA)

(CENTROS EXTREMOS Y VECTOR PERPENDICULAR A LA RANURA)
#30 = #24 + #7 * COS[#1] (X DEL CENTRO DERECHO)
#31 = #25 + #7 * SIN[#1] (Y DEL CENTRO DERECHO)
#32 = -SIN[#1] (COMPONENTE X DEL VECTOR PERPENDICULAR)
#33 = COS[#1]  (COMPONENTE Y DEL VECTOR PERPENDICULAR)

(RADIO MAXIMO DE TRAYECTORIA DEL CENTRO Y PASO RADIAL)
#34 = #18 - #15
#35 = #20 * 0.65
IF [#35 LE 0] #35 = #20 * 0.5
#36 = FUP[#34 / #35]
IF [#36 LT 1] #36 = 1

(ARRANQUE DE HUSILLO Y POSICIONAMIENTO EN EL CENTRO IZQUIERDO)
G90 G00 S#19 M03
G00 X#24 Y#25
G00 Z#2
G01 Z-[#26] F[#9 / 2.0]

(BARRIDO CONCENTRICO TIPO RACETRACK, DE DENTRO HACIA AFUERA)
#23 = 1
WHILE [#23 LE #36] DO1
  #37 = [#34 * #23] / #36
  #38 = #24 + #32 * #37
  #39 = #25 + #33 * #37

  (LADO SUPERIOR HACIA EL CENTRO DERECHO)
  G90 G01 X#38 Y#39 F#9
  G01 X[#30 + #32 * #37] Y[#31 + #33 * #37]

  (ARCO EXTREMO DERECHO 180 GRADOS)
  G02 X[#30 - #32 * #37] Y[#31 - #33 * #37] I[-#32 * #37] J[-#33 * #37]

  (LADO INFERIOR DE REGRESO AL CENTRO IZQUIERDO)
  G01 X[#24 - #32 * #37] Y[#25 - #33 * #37]

  (ARCO EXTREMO IZQUIERDO 180 GRADOS)
  G02 X#38 Y#39 I[#32 * #37] J[#33 * #37]

  #23 = #23 + 1
END1

(RETIRADA A PLANO DE SEGURIDAD)
G90 G00 Z25.0
GOTO9999

(MENSAJES DE ALARMA DE SEGURIDAD #3000)
N9101 #3000 = 101 (DISTANCIA ENTRE CENTROS D DEBE SER MAYOR A CERO)
N9102 #3000 = 102 (RADIO DE RANURA R DEBE SER MAYOR A CERO)
N9103 #3000 = 103 (DIAMETRO DE HERRAMIENTA T DEBE SER MAYOR A CERO)
N9104 #3000 = 104 (PROFUNDIDAD Z DEBE SER MAYOR A CERO)
N9105 #3000 = 105 (AVANCE F DEBE SER MAYOR A CERO)
N9106 #3000 = 106 (DIAMETRO DE HERRAMIENTA DEBE SER MENOR QUE 2R)
N9107 #3000 = 107 (VELOCIDAD DE HUSILLO S DEBE SER MAYOR A CERO)

N9999 G#10
M99
%
