%
O8108 (MECANIZADO DE RANURA RECTA ANGULAR)
(PETER SMID - FANUC CNC CUSTOM MACROS - CAPITULO 20)
(LLAMADA G65: G65 P8108 X.. Y.. Z.. A.. D.. R.. T.. F..)

(VARIABLES DE ENTRADA DEL OPERARIO)
(1. DIMENSIONES GEOMETRICAS)
#24 = 30.0   (X: COORDENADA X CENTRO INICIAL RANURA)
#25 = 25.0   (Y: COORDENADA Y CENTRO INICIAL RANURA)
#1  = 25.0   (A: ORIENTACION ANGULAR EN GRADOS DESDE X+)
#7  = 60.0   (D: DISTANCIA ENTRE CENTROS EXTREMOS)
#18 = 10.0   (R: RADIO DE LA RANURA - ANCHO TOTAL 20MM)

(2. CONDICIONES DE CORTE Y HERRAMIENTA)
#20 = 10.0   (T: DIAMETRO DE LA FRESA DE CORTE)
#9  = 300.0  (F: VELOCIDAD DE AVANCE DE CORTE EN MM/MIN)
#19 = 1600.0 (S: VELOCIDAD DEL HUSILLO EN RPM)

(3. ESTRATEGIA DE MECANIZADO Y SEGURIDAD)
#26 = 6.0    (Z: PROFUNDIDAD TOTAL DE LA RANURA)
#2  = 2.0    (B: PLANO DE SEGURIDAD EN Z)

(CONTROL DE ERRORES Y SEGURIDAD)
IF [#7 LE 0]  GOTO9101
IF [#18 LE 0] GOTO9102
IF [#20 LE 0] GOTO9103
IF [#26 LE 0] GOTO9104
IF [#9 LE 0]  GOTO9105
#15 = #20 / 2.0
IF [#15 GE #18] GOTO9106

#10 = #4003

(ARRANQUE DE HUSILLO Y POSICIONAMIENTO EN CENTRO IZQUIERDO)
G90 G00 S#19 M03
G00 X#24 Y#25
G00 Z#2
G01 Z-[#26] F[#9 / 2.0]

(1. BARRIDO CENTRAL HACIA EL SEGUNDO CENTRO)
#124 = COS[#1] * #7
#125 = SIN[#1] * #7
G91 G01 X#124 Y#125 F#9

(2. ARCO EXTREMO DERECHO 180 GRADOS)
#114 = COS[#1 + 90.0] * #18
#115 = SIN[#1 + 90.0] * #18
#124 = COS[#1 + 90.0] * [#18 * 2.0]
#125 = SIN[#1 + 90.0] * [#18 * 2.0]
G03 X#124 Y#125 I#114 J#115

(3. BARRIDO LATERAL SUPERIOR DE REGRESO)
#124 = COS[#1 + 180.0] * #7
#125 = SIN[#1 + 180.0] * #7
G01 X#124 Y#125

(4. ARCO EXTREMO IZQUIERDO 180 GRADOS)
#114 = COS[#1 - 90.0] * #18
#115 = SIN[#1 - 90.0] * #18
#124 = COS[#1 - 90.0] * [#18 * 2.0]
#125 = SIN[#1 - 90.0] * [#18 * 2.0]
G03 X#124 Y#125 I#114 J#115

(5. RETORNO AL CENTRO Y RETIRADA EN Z)
#124 = COS[#1 + 90.0] * #18
#125 = SIN[#1 + 90.0] * #18
G01 X#124 Y#125 F#9

G90 G00 Z25.0
GOTO9999

(MENSAJES DE ALARMA DE SEGURIDAD #3000)
N9101 #3000 = 101 (DISTANCIA ENTRE CENTROS D DEBE SER MAYOR A CERO)
N9102 #3000 = 102 (RADIO DE RANURA R DEBE SER MAYOR A CERO)
N9103 #3000 = 103 (DIAMETRO DE HERRAMIENTA T DEBE SER MAYOR A CERO)
N9104 #3000 = 104 (PROFUNDIDAD Z DEBE SER MAYOR A CERO)
N9105 #3000 = 105 (AVANCE F DEBE SER MAYOR A CERO)
N9106 #3000 = 106 (HERRAMIENTA DEMASIADO GRANDE PARA LA RANURA)

N9999 G#10
M99
%\n