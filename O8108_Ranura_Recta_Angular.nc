%
O8108 (MECANIZADO DE RANURA RECTA ANGULAR)
(INGENIERO NESTOR GAMEZ - FANUC CNC CUSTOM MACROS)
(LLAMADA G65: G65 P8108 X.. Y.. A.. D.. R.. T.. F.. S.. Z.. B.. K..)

(VARIABLES DE ENTRADA DEL OPERARIO)
(1. DIMENSIONES GEOMETRICAS)
#24 = 30.0   (X: COORDENADA X CENTRO INICIAL RANURA)
#25 = 25.0   (Y: COORDENADA Y CENTRO INICIAL RANURA)
#1  = 25.0   (A: ORIENTACION ANGULAR EN GRADOS DESDE X+)
#7  = 60.0   (D: DISTANCIA ENTRE CENTROS EXTREMOS)
#18 = 10.0   (R: RADIO NOMINAL DE LA RANURA - ANCHO TOTAL 2R)

(2. CONDICIONES DE CORTE Y HERRAMIENTA)
#20 = 10.0   (T: DIAMETRO DE LA FRESA DE CORTE)
#9  = 300.0  (F: VELOCIDAD DE AVANCE DE CORTE EN MM/MIN)
#19 = 1600.0 (S: VELOCIDAD DEL HUSILLO EN RPM)

(3. ESTRATEGIA DE MECANIZADO Y SEGURIDAD)
#26 = 6.0    (Z: PROFUNDIDAD TOTAL DE LA RANURA)
#2  = 2.0    (B: PLANO DE SEGURIDAD EN Z)
#6  = 2.0    (K: PROFUNDIDAD MAXIMA POR PASADA EN Z)

(CONTROL DE ERRORES Y SEGURIDAD)
IF [#7 LE 0]  GOTO9101
IF [#18 LE 0] GOTO9102
IF [#20 LE 0] GOTO9103
IF [#26 LE 0] GOTO9104
IF [#9 LE 0]  GOTO9105
IF [#19 LE 0] GOTO9107
IF [#2 EQ 0]  #2 = 2.0
IF [#6 LE 0]  #6 = #26

#10 = #4003
#15 = #20 / 2.0      (RADIO DE LA FRESA)
IF [#15 GT #18] GOTO9106 (LA HERRAMIENTA EXCEDE EL ANCHO DE LA RANURA)

(OFFSET RADIAL MAXIMO DESDE EL CENTRO)
#8  = #18 - #15

(TRIGONOMETRIA Y CENTRO OPUESTO)
#4  = COS[#1]        (COSENO ANGULO A)
#5  = SIN[#1]        (SENO ANGULO A)
#11 = #24 + #7 * #4  (X DEL CENTRO OPUESTO)
#12 = #25 + #7 * #5  (Y DEL CENTRO OPUESTO)

(VECTOR PERPENDICULAR NORMAL UNITARIO A LA RANURA)
#13 = -#5            (COMPONENTE NORMAL EN X)
#14 = #4             (COMPONENTE NORMAL EN Y)

(PASO LATERAL RADIAL Y NUMERO DE PASADAS)
#17 = #20 * 0.65
IF [#17 LE 0] #17 = #20 * 0.5
#3  = 0
IF [#8 GT 0]  #3 = FUP[#8 / #17]

(AVANCES CONTROLADOS DE PENETRACION Y APERTURA CENTRAL)
#32 = #9 * 0.4       (AVANCE DE PENETRACION EN Z)
#16 = #9 * 0.7       (AVANCE PARA APERTURA DE CANAL CERRADO)

(PROFUNDIDAD NETA EN Z Y PASO POR PASADA)
#28 = ABS[#26]
#29 = ABS[#6]
IF [#29 GT #28] #29 = #28

(ARRANQUE DE HUSILLO Y POSICIONAMIENTO EN EL CENTRO INICIAL)
G90 G00 S#19 M03
G00 X#24 Y#25
G00 Z50.0            (PLANO SEGURO INICIAL)
G00 Z#2

(BUCLE PRINCIPAL DE PROFUNDIDAD EN Z)
#27 = 0.0
WHILE [#27 LT #28] DO1
  #27 = #27 + #29
  IF [#27 GT #28] #27 = #28

  (PENETRACION EN Z EN EL CENTRO CON AVANCE CONTROLADO)
  G90 G01 Z-[#27] F#32

  (PASADA CENTRAL DE APERTURA DE RANURA CON AVANCE DE CORTE AL 70%)
  G01 X#11 Y#12 F#16

  (SI EL DIAMETRO DE FRESA ES IGUAL AL ANCHO DE RANURA, SALTAR ENSANCHADO)
  IF [#8 LE 0] GOTO800

  (RETORNO AL CENTRO INICIAL POR EL CANAL YA ABIERTO)
  G01 X#24 Y#25 F#9

  (BARRIDO CONCENTRICO TIPO RACETRACK DE ADENTRO HACIA AFUERA)
  #23 = 1
  WHILE [#23 LE #3] DO2
    #21 = [#8 * #23] / #3
    #30 = #13 * #21
    #31 = #14 * #21

    (APROXIMACION PERPENDICULAR AL LADO SUPERIOR)
    G01 X[#24 + #30] Y[#25 + #31] F#9

    (TRAYECTORIA LINEAL LADO 1 HACIA EL CENTRO OPUESTO)
    G01 X[#11 + #30] Y[#12 + #31]

    (ARCO EXTREMO OPUESTO 180 GRADOS)
    G02 X[#11 - #30] Y[#12 - #31] I[-#30] J[-#31]

    (TRAYECTORIA LINEAL LADO 2 DE REGRESO AL CENTRO INICIAL)
    G01 X[#24 - #30] Y[#25 - #31]

    (ARCO EXTREMO INICIAL 180 GRADOS)
    G02 X[#24 + #30] Y[#25 + #31] I[#30] J[#31]

    #23 = #23 + 1
  END2

  (RETORNO AL CENTRO DE LA RANURA)
  G01 X#24 Y#25 F#9

N800
  (DESPEGAR EN Z AL PLANO SEGURO ANTES DEL SIGUIENTE NIVEL)
  G90 G00 Z#2
  G00 X#24 Y#25
END1

(RETIRADA A PLANO DE SEGURIDAD Z50)
G90 G00 Z50.0
GOTO9999

(MENSAJES DE ALARMA DE SEGURIDAD #3000)
N9101 #3000 = 101 (DISTANCIA ENTRE CENTROS D DEBE SER MAYOR A CERO)
N9102 #3000 = 102 (RADIO DE RANURA R DEBE SER MAYOR A CERO)
N9103 #3000 = 103 (DIAMETRO DE HERRAMIENTA T DEBE SER MAYOR A CERO)
N9104 #3000 = 104 (PROFUNDIDAD Z DEBE SER MAYOR A CERO)
N9105 #3000 = 105 (AVANCE F DEBE SER MAYOR A CERO)
N9106 #3000 = 106 (DIAMETRO DE HERRAMIENTA EXCEDE EL ANCHO 2R)
N9107 #3000 = 107 (VELOCIDAD DE HUSILLO S DEBE SER MAYOR A CERO)

N9999 G#10
M99
%
