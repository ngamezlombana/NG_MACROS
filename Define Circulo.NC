O1005 (CONTORNO INTERNO MULTIPASADA - ENTRADA TANGENCIAL)

(========================================)
(--- VARIABLES DE ENTRADA DEL OPERARIO ---)
(========================================)
#1 = 102.0 (DIAMETRO FINAL A MAQUINAR)
#2 = 12.0  (DIAMETRO DE LA HERRAMIENTA)
#3 = 1.0   (NUMERO DE POT/HTA EN EL MAGAZINE - EJ: T5)
#4 = 0.0   (Z INICIAL DESDE DONDE INICIA EL CORTE)
#5 = -18.0 (Z FINAL ABSOLUTO - EJ: COORDENADA NEGATIVA)
#6 = 0.3   (PROFUNDIDAD DE CORTE POR PASADA EN Z)
#7 = 0   (SOBREMATERIAL EN EL RADIO PARA ACABADO)
#8 = 0.5   (SOBREMATERIAL EN LA PROFUNDIDAD Z)
#9 = 180.0 (Vc - VELOCIDAD DE CORTE EN m/min)
#10 = 4.0  (NUMERO DE FILOS O INSERTOS)
#11 = 0.1  (fz - AVANCE POR FILO EN mm/rev)
#12 = 1  (CANTIDAD DE PASADAS RADIALES)
#13 = 2.0  (PROFUNDIDAD RADIAL POR CADA PASADA)
#14 = 50.0 (PLANO DE SEGURIDAD RETROCESO R)
#15 = 0.0  (COORDENADA DEL CENTRO EN X)
#16 = 0.0  (COORDENADA DEL CENTRO EN Y)
#17 = 5.0  (RADIO DE ENTRADA Y SALIDA TANGENCIAL)
(========================================)

(--- COMPROBACIONES DE SEGURIDAD BÁSICAS ---)
IF [#2 GE #1] GOTO 9001
IF [#4 LE #5] GOTO 9002
IF [#12 LT 1] GOTO 9003

(--- PARAMETROS DE CORTE ---)
#100 = ROUND[[#9 * 1000] / [3.1416 * #2]] (RPM FIJAS)
#101 = ROUND[#100 * #10 * #11] (AVANCE NOMINAL LINEAL F)

(--- GEOMETRIA Y LIMITES EXACTOS ---)
#104 = #5 + #8 (Z FINAL EFECTIVO DEJANDO SOBREMATERIAL EN EL FONDO)
#105 = #4 (INICIALIZADOR DE PROFUNDIDAD Z ACTUAL)

#107 = [#1 / 2] - #7 (RADIO FINAL EFECTIVO DE LA PARED)
#108 = #107 - [#2 / 2] (RADIO MAXIMO DE LA TRAYECTORIA CENTRO HTA)

(RADIO DE TRAYECTORIA DE LA PRIMERA PASADA)
#109 = #108 - [[#12 - 1] * #13] 
IF [#109 LE 0] GOTO 9005 (ALARMA: NO HAY ESPACIO PARA TANTAS PASADAS RADIALES)
IF [#17 GE #109] GOTO 9006 (ALARMA: RADIO DE ENTRADA MAYOR AL ESPACIO DISPONIBLE)

(--- CAMBIO DE HERRAMIENTA Y ENCABEZADO ---)
T#3 M06 
G90 G54 G17 G40 G80 G49

(POSICIONAMIENTO INICIAL DIRECTO AL PUNTO DE ESPERA DEL PRIMER ARCO)
(NO VA AL CENTRO, VA AL ESPACIO VACIO CERCA DE LA PARED)
G00 X[#15 + #109 - #17] Y[#16 - #17] 
G43 H#3 Z#14 
S#100 M03
M08

(BAJADA SEGURA DE APROXIMACION)
G00 Z[#4 + 1.0]

(--- BUCLE PRINCIPAL DE PROFUNDIDAD EN Z ---)
WHILE [#105 GT #104] DO 1
    #105 = #105 - #6
    IF [#105 GE #104] GOTO 20
    #105 = #104 
    N20

    (BAJADA CONTROLADA EN Z EN LA POSICION DE PREPARACION DESCENTRADA)
    G01 Z#105 F[#101 / 2]

    (--- BUCLE INTERNO DE PASADAS RADIALES ---)
    #110 = 1 (INICIALIZA EL CONTADOR DE PASADAS)

    WHILE [#110 LE #12] DO 2
        (CALCULA EL RADIO OBJETIVO DE ESTA PASADA)
        #111 = #108 - [[#12 - #110] * #13] 
        
        (AVANCE COMPENSADO PARA MANTENER ESPESOR DE VIRUTA CONSTANTE)
        #112 = ROUND[#101 * [#111 * 2] / [[#111 * 2] + #2]]

        (MOVIMIENTO LINEAL AL PUNTO DE INICIO DEL ARCO EN LA PASADA ACTUAL)
        G01 X[#15 + #111 - #17] Y[#16 - #17] F#101
        
        (ARCO DE ENTRADA TANGENCIAL 90 GRADOS)
        G03 X[#15 + #111] Y#16 I0. J#17 F#112

        (INTERPOLACION CIRCULAR COMPLETA ANTI-HORARIA DE 360 GRADOS)
        G03 I-[#111] J0. F#112

        (ARCO DE SALIDA TANGENCIAL 90 GRADOS)
        G03 X[#15 + #111 - #17] Y[#16 + #17] I-[#17] J0. F#112
        
        #110 = #110 + 1 (AUMENTA EL CONTADOR Y REPITE HASTA COMPLETARLAS TODAS)
    END 2

    (--- OPTIMIZACION: DESPEJE EN Z Y RETORNO AL INICIO DEL NIVEL ---)
    G01 Z[#105 + 1.0] F#101 (SE LEVANTA 1MM PARA NO ARRASTRAR EL INSERTO)
    
    (RETORNA EN VACIO A LA POSICION INICIAL DE LA PRIMERA PASADA PARA BAJAR EL SIGUIENTE Z)
    G00 X[#15 + #109 - #17] Y[#16 - #17] 

END 1

(--- FIN DE PROGRAMA ---)
G00 Z#14
M09
M05
G28 G91 Z0.
G90
M30

(--- CODIGOS DE ALARMA ---)
N9001 #3000=1 (ERROR: HTA MAYOR O IGUAL AL CONTORNO)
N9002 #3000=2 (ERROR: Z INICIAL MENOR O IGUAL A Z FINAL)
N9003 #3000=3 (ERROR: NUMERO DE PASADAS RADIALES MENOR A 1)
N9005 #3000=5 (ERROR: ESPACIO RADIAL INSUFICIENTE PARA LAS PASADAS)
N9006 #3000=6 (ERROR: RADIO ENTRADA MAYOR AL ESPACIO DISPONIBLE)