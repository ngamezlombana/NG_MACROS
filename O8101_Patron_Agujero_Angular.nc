%
O8101 (PATRON DE AGUJERO ANGULAR - VERSION 1)
(INGENIERO NESTOR GAMEZ - FANUC CNC CUSTOM MACROS)
(LLAMADA G65: G65 P8101 X.. Y.. A.. Q.. H.. T.. F.. S.. Z.. R.. E..)

(VARIABLES DE ENTRADA DEL OPERARIO)
(1. DIMENSIONES GEOMETRICAS)
#24 = 50.0   (X: COORDENADA X DEL PRIMER AGUJERO)
#25 = 30.0   (Y: COORDENADA Y DEL PRIMER AGUJERO)
#1  = 30.0   (A: ANGULO DE LA LINEA EN GRADOS DESDE X+)
#17 = 25.0   (Q: PASO O DISTANCIA ENTRE AGUJEROS ADYACENTES)
#11 = 5.0    (H: NUMERO TOTAL DE AGUJEROS)

(2. CONDICIONES DE CORTE Y HERRAMIENTA)
#20 = 10.0   (T: DIAMETRO DE LA BROCA / HERRAMIENTA)
#9  = 250.0  (F: AVANCE DE TALADRADO EN MM/MIN)
#19 = 1200.0 (S: VELOCIDAD DEL HUSILLO EN RPM)

(3. ESTRATEGIA DE PERFORADO Y SEGURIDAD)
#26 = 20.0   (Z: PROFUNDIDAD TOTAL DE PERFORACION)
#18 = 2.0    (R: PLANO DE RETROCESO Y SEGURIDAD)
#8  = 5.0    (E: PASO DE PICOTEO EN Z PARA G83)

(CONTROL DE ERRORES Y SEGURIDAD)
IF [#11 LT 2] GOTO9101
IF [#17 LE 0] GOTO9102
IF [#26 LE 0] GOTO9103
IF [#9 LE 0]  GOTO9104
IF [#20 LE 0] GOTO9105
IF [#8 LE 0]  GOTO9106
IF [#18 LT 0] #18 = 2.0

(GUARDA ESTADO PREVIO DE G90/G91)
#10 = #4003

(CALCULO DE DELTAS EN X E Y)
#14 = #17 * COS[#1]   (PASO INCREMENTAL EN X)
#15 = #17 * SIN[#1]   (PASO INCREMENTAL EN Y)

(VARIABLES DE POSICION ACTUAL)
#31 = #24             (POSICION ACTUAL X)
#32 = #25             (POSICION ACTUAL Y)
#33 = 1               (CONTADOR DE AGUJEROS INICIADO EN 1)

(ARRANQUE DE HUSILLO Y APROXIMACION SEGURA)
S#19 M03 M08
G90 G00 X#31 Y#32
G00 Z50.0             (PLANO SEGURO INICIAL)
G00 Z#18              (PLANO DE RETROCESO R)

(TALADRADO DEL PRIMER AGUJERO)
G99 G83 X#31 Y#32 Z-[#26] R#18 Q#8 F#9

(BUCLE PARA LOS AGUJEROS RESTANTES EN G90 ABSOLUTO)
WHILE [#33 LT #11] DO1
  #31 = #24 + [#33 * #14]
  #32 = #25 + [#33 * #15]
  X#31 Y#32
  #33 = #33 + 1
END1

G80                   (CANCELAR CICLO FIJO)
G90 G00 Z50.0         (SUBIR A ALTURA SEGURA)
GOTO9999

(MENSAJES DE ALARMA DE SEGURIDAD #3000)
N9101 #3000 = 101 (NUMERO DE AGUJEROS DEBE SER MAYOR A 1)
N9102 #3000 = 102 (EL PASO Q DEBE SER MAYOR A CERO)
N9103 #3000 = 103 (PROFUNDIDAD Z DEBE SER MAYOR A CERO)
N9104 #3000 = 104 (AVANCE F DEBE SER MAYOR A CERO)
N9105 #3000 = 105 (DIAMETRO DE HERRAMIENTA T DEBE SER MAYOR A CERO)
N9106 #3000 = 106 (PASO DE PICOTEO E DEBE SER MAYOR A CERO)

N9999 G#10
M99
%
