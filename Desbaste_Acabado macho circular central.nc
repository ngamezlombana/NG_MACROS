O1003 (MACHO CIRCULAR - DESBASTE Y ACABADO V3)

(========================================)
(--- VARIABLES DE ENTRADA DEL OPERARIO ---)
#20 = 1     (NUMERO DE HERRAMIENTA)
(========================================)
#1 = 250.0 (DIAMETRO EXTERIOR INICIAL)
#2 = 85.0  (DIAMETRO FINAL DEL MACHO)
#3 = 10.0  (DIAMETRO DE LA HERRAMIENTA)
#4 = 10.0  (PROFUNDIDAD TOTAL Z FINAL - POSITIVO)
#5 = 2.5   (PROFUNDIDAD DE CORTE POR PASADA Z)
#6 = 6.0   (PASO RADIAL - DISTANCIA ENTRE PASADAS)
#7 = 0.5   (SOBREMATERIAL ACABADO EN PARED)
#8 = 0.2   (SOBREMATERIAL ACABADO EN FONDO Z)
#9 = 50.0  (PLANO DE SEGURIDAD RETROCESO R)
#10 = 150.0 (Vc - VELOCIDAD DE CORTE)
#11 = 4.0   (NUMERO DE INSERTOS)
#12 = 0.12  (fz - AVANCE POR INSERTO)
#13 = 0.0   (CENTRO X)
#14 = 0.0   (CENTRO Y)
#15 = 0.0   (Z INICIAL)
#16 = 2.0   (OPCION: 0=AMBOS, 1=SOLO DESBASTE, 2=SOLO ACABADO)
(========================================)

(--- COMPROBACIONES DE SEGURIDAD ---)
IF [#2 GE #1] GOTO 9001
IF [#6 GE #3] GOTO 9002
IF [#15 LE -#4] GOTO 9003
IF [#16 LT 0] GOTO 9005

(--- PARAMETROS DE CORTE ---)
#100 = ROUND[[#10 * 1000] / [3.1416 * #3]]
#101 = ROUND[#100 * #11 * #12] 
#102 = #3 / 2 (RADIO HTA)

(--- GEOMETRIA ---)
#104 = -[#4 - #8] (Z FINAL DESBASTE)
#109 = -#4        (Z FINAL ACABADO)
#108 = [#2 / 2] + #7 + #102 (RADIO TRAYECTORIA DESBASTE)
#118 = [#2 / 2] + #102       (RADIO TRAYECTORIA ACABADO)
#107 = [#1 / 2] - #102       (PUNTO INICIO EXTERIOR)
#110 = ROUND[#101 * [#118 * 2] / [[#118 * 2] - #3]] (AVANCE ACABADO)

T#20 M06 (LLAMAR HERRAMIENTA)
G90 G54 G17 G40 G80 G49
G00 X[#13 + #107] Y#14 (POSICIONAMIENTO EN RAPIDO AL PUNTO DE INICIO)
G43 H#20 Z#9 (*** VERIFICAR CORRECTOR DE ALTURA H ***)
S#100 M03 M08

(--- SELECCION DE CICLO ---)
IF [#16 EQ 2] GOTO 200

(========================================)
(           RUTINA DE DESBASTE           )
(========================================)
#105 = #15 (INICIALIZADOR Z ACTUAL)
#106 = #15 (INICIALIZADOR Z ANTERIOR PARA RAPIDOS)

WHILE [#105 GT #104] DO 1
    #105 = #105 - #5
    IF [#105 LT #104] THEN #105 = #104
    
    G00 X[#13 + #107] Y#14
    G00 Z[#106 + 1.0] (BAJADA EN RAPIDO A 1MM DEL NIVEL MECANIZADO ANTERIOR)
    G01 Z#105 F[#101 / 2] (BAJADA DE CORTE AL NUEVO NIVEL)
    
    #111 = #107
    WHILE [#111 GT #108] DO 2
        G01 X[#13 + #111] F#101
        G02 I-[#111] J0. F#101
        #111 = #111 - #6
        IF [#111 LT #108] THEN #111 = #108
    END 2
    
    G01 X[#13 + #108] F#101
    G02 I-[#108] J0.
    
    #106 = #105 (ACTUALIZA Z ANTERIOR CON EL NIVEL QUE SE ACABA DE MECANIZAR)
    G00 Z#9 (RETROCESO AL PLANO DE SEGURIDAD)
END 1

IF [#16 EQ 1] GOTO 999

(========================================)
(            RUTINA DE ACABADO           )
(========================================)
N200
G00 X[#13 + #118] Y#14
G00 Z[#104 + 1.0] (BAJA EN RAPIDO HASTA 1MM SOBRE EL FONDO DESBASTADO)
G01 Z#109 F[#101 / 2] (BAJADA CONTROLADA PARA EL CORTE DEL FONDO DE ACABADO)
G02 I-[#118] J0. F#110
G00 Z#9

N999
G00 Z#9
M09 M05
G28 G91 Z0.
G90
M30

(--- ALARMAS ---)
N9001 #3000=1 (ERROR: MACHO > BRUTO)
N9002 #3000=2 (ERROR: PASO RADIAL > HTA)
N9003 #3000=3 (ERROR: Z INICIAL < Z FINAL)
N9005 #3000=5 (ERROR: OPCION 0-1-2)
