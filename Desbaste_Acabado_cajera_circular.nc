O1003 (CAJA CIRCULAR DESBASTE-ACABADO CON REINICIO EN Z)

(========================================)
(--- VARIABLES DE ENTRADA DEL OPERARIO ---)
#20 = 1     (NUMERO DE HERRAMIENTA)
(========================================)
#1 = 80.0   (DIAMETRO FINAL DE LA CAJA)
#2 = 12.0   (DIAMETRO DE LA HERRAMIENTA)
#3 = 20.0   (PROFUNDIDAD TOTAL Z FINAL - VALOR POSITIVO EJ: 20)
#4 = 5.0    (PROFUNDIDAD POR PASADA EN Z DESBASTE)
#5 = 0.5    (SOBREMATERIAL RADIAL PARA EL ACABADO)
#6 = 160.0  (Vc - VELOCIDAD DE CORTE EN m/min)
#7 = 4.0    (NUMERO DE INSERTOS O LABIOS)
#8 = 0.08   (fz - AVANCE POR INSERTO EN mm/rev)
#9 = 50.0   (PLANO DE SEGURIDAD RETROCESO R)
#10 = 0.0   (CENTRO DE LA CAJA EN X)
#11 = 0.0   (CENTRO DE LA CAJA EN Y)
#12 = 8.0   (PASO RADIAL MAXIMO DESBASTE XY)
#14 = 0.0   (Z INICIAL DE CORTE / REINICIO - EJ: -10.0)
#15 = 4.0   (RADIO DEL ARCO ENTRADA Y SALIDA ACABADO)
#16 = 0.0   (OPCION: 0=AMBOS, 1=SOLO DESBASTE, 2=SOLO ACABADO)
(========================================)

(--- COMPROBACIONES DE SEGURIDAD BASICAS ---)
IF [#2 GE #1] GOTO 9001
IF [#14 LE -#3] GOTO 9003
IF [#16 LT 0] GOTO 9005
IF [#16 GT 2] GOTO 9005

(--- CALCULOS DE PARAMETROS DE CORTE ---)
#100 = ROUND[[#6 * 1000] / [3.1416 * #2]] (CALCULO DE RPM)
#101 = ROUND[#100 * #7 * #8] (AVANCE LINEAL NOMINAL F)

(--- CALCULOS INTERNOS DE GEOMETRIA ---)
#102 = #1 - [#5 * 2] (DIAMETRO EFECTIVO DEL DESBASTE)
#103 = [#102 / 2] - [#2 / 2] (RADIO DE TRAYECTORIA DESBASTE)
#113 = [#1 / 2] - [#2 / 2] (RADIO DE TRAYECTORIA ACABADO)

(--- VALIDACION DE ARCO ---)
IF [#15 GE #113] GOTO 9004

(--- CALCULO AVANCES COMPENSADOS PARA INTERPOLACION ---)
#106 = ROUND[#101 * [#102 - #2] / #102] (AVANCE COMPENSADO DESBASTE)
#116 = ROUND[#101 * [#1 - #2] / #1] (AVANCE COMPENSADO ACABADO)
#104 = -#3 (Z FINAL EN COORDENADA NEGATIVA)

(--- ENCABEZADO DE MAQUINA Y POSICIONAMIENTO ---)
T#20 M06 (LLAMAR HERRAMIENTA)
G90 G54 G17 G40 G80 G49
G00 X#10 Y#11 (POSICIONAMIENTO DIRECTO AL CENTRO DE LA CAJA)
G43 H#20 Z#9 (*** VERIFICAR CORRECTOR DE ALTURA H ***)
S#100 M03
M08

(--- ACERCAMIENTO RAPIDO OPTIMIZADO AL Z DE REINICIO ---)
G00 Z[#14 + 1.0] (BAJA EN RAPIDO HASTA 1MM POR ENCIMA DEL Z INICIAL)

(--- CONTROL DE FLUJO Y SELECCION DE CICLO ---)
IF [#16 EQ 2] GOTO 200 (SALTA DIRECTO A RUTINA DE ACABADO)

(========================================)
(       RUTINA DE DESBASTE (N100)        )
(========================================)
#105 = #14 (INICIALIZA PROFUNDIDAD Z ACTUAL)

N100 (--- INICIO BUCLE PROFUNDIDAD Z ---)
IF [#105 LE #104] GOTO 190
#105 = #105 - #4
IF [#105 LT #104] THEN #105 = #104

G00 X#10 Y#11 (ASEGURA POSICION EN CENTRO ANTES DE BAJAR)
G01 Z#105 F[#101 / 2] (BAJADA EN Z AL NUEVO NIVEL)

#107 = 0 (INICIALIZA CRECIMIENTO RADIAL ACTUAL)

N110 (--- BUCLE DE EXPANSIÓN RADIAL XY ---)
#107 = #107 + #12
IF [#107 LT #103] GOTO 115
#107 = #103 (LIMITA AL RADIO EFECTIVO DE DESBASTE EXACTO)

N115
G01 X[#10 + #107] F#101 (AVANCE LINEAL AL NUEVO RADIO)
G03 I-[#107] J0. F#106 (INTERPOLACION CIRCULAR COMPLETA)

IF [#107 LT #103] GOTO 110 (REPITE HASTA ALCANZAR DIAMETRO DESBASTE)

(*** LEVANTAMIENTO DE SEGURIDAD OBLIGATORIO ***)
G00 Z#9 (SUBE AL PLANO SEGURO R PARA DESPEJAR)
G00 X#10 Y#11 (RETORNO AL CENTRO EN EL AIRE PARA NO DEJAR MARCAS)
G00 Z[#105 + 1.0] (BAJA EN RAPIDO AL ULTIMO NIVEL MECANIZADO PARA AHORRAR TIEMPO)

GOTO 100 (REPETIR BUCLE Z HASTA LLEGAR AL FONDO)

N190 (--- FIN DE DESBASTE ---)
IF [#16 EQ 1] GOTO 999 (SI LA OPCION ES 1, FINALIZA AQUI)

(========================================)
(       RUTINA DE ACABADO (N200)         )
(========================================)
N200
G00 X#10 Y#11 (POSICIONA EN EL CENTRO EXACTO)
G01 Z#104 F[#101 / 2] (BAJA DIRECTAMENTE A LA PROFUNDIDAD Z FINAL)

(PREPARACION DE COORDENADA PARA ARCO TANGENCIAL)
G01 X[#10 - #15] Y[#11 + #113 - #15] F#101

(ARCO DE ENTRADA TANGENCIAL DE 90 GRADOS)
G03 X[#10] Y[#11 + #113] I#15 J0. F#116

(INTERPOLACION CIRCULAR COMPLETA A DIAMETRO FINAL)
G03 I0. J-[#113]

(ARCO DE SALIDA TANGENCIAL DE 90 GRADOS)
G03 X[#10 + #15] Y[#11 + #113 - #15] I0. J-[#15]

(*** LEVANTAMIENTO DE SEGURIDAD ***)
G00 Z#9 (RETIRADA DIRECTA Z)
G00 X#10 Y#11 (VUELTA AL CENTRO)

N999 (--- FIN DE MECANIZADO ---)
G00 Z#9
M09
M05
G28 G91 Z0.
G90
M30

(--- ALARMAS Y ERRORES ---)
N9001 #3000=1 (ERROR: HTA MAYOR QUE CAJA)
N9003 #3000=3 (ERROR: Z INICIAL INFERIOR A Z FINAL)
N9004 #3000=4 (ERROR: RADIO ENTRADA EXCESIVO)
N9005 #3000=5 (ERROR: OPCION DE CICLO DEBE SER 0, 1 O 2)
