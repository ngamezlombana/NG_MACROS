O1006 (FRESADO DE ROSCAS RH - CLIMB MILLING CCW - MULTI-PASADA RADIAL)

(========================================)
(--- VARIABLES DE ENTRADA DEL OPERARIO ---)
#20 = 1     (NUMERO DE HERRAMIENTA)
(========================================)
#1 = 64.0   (DIAMETRO NOMINAL FIN DE LA ROSCA)
#2 = 20.0   (DIAMETRO DE LA FRESA DE ROSCAR)
#3 = 30.0   (PROFUNDIDAD TOTAL DE LA ROSCA - Z FINAL POSITIVO)
#4 = 2.0    (PASO DE LA ROSCA / PITCH - EJ: 2.0mm)
#5 = 1.0    (NUMERO DE VUELTAS: 1=FRESA MULTIPASO, VARIAS=FRESA UN FILO)
#6 = 120.0  (Vc - VELOCIDAD DE CORTE EN m/min)
#7 = 4.0    (NUMERO DE INSERTOS O LABIOS)
#8 = 0.05   (fz - AVANCE POR INSERTO EN mm/rev)
#9 = 50.0   (PLANO DE SEGURIDAD RETROCESO R)
#10 = 0.0   (COORDENADA X DEL CENTRO DEL AGUJERO)
#11 = 0.0   (COORDENADA Y DEL CENTRO DEL AGUJERO)
#12 = 10     (NUMERO DE PASADAS RADIALES: 1=PASADA UNICA DIRECTA AL DIAMETRO FINAL)
#13 = 0.02   (PROFUNDIDAD RADIAL POR PASADA EN mm)
(========================================)

(--- COMPROBACIONES DE SEGURIDAD BASICAS ---)
IF [#2 GE #1] GOTO 9001
IF [#4 LE 0] GOTO 9002
IF [#5 LT 1.0] GOTO 9003
IF [#12 LT 1] GOTO 9004
IF [#13 LE 0] GOTO 9005

(--- CALCULOS DE PARAMETROS DE CORTE ---)
#100 = ROUND[[#6 * 1000] / [3.1416 * #2]] (CALCULO DE RPM)
#101 = ROUND[#100 * #7 * #8] (AVANCE LINEAL NOMINAL F)

(--- CALCULOS GEOMETRICOS DE LA TRAYECTORIA ---)
#102 = [#1 - #2] / 2 (RADIO EFECTIVO FINAL DE LA TRAYECTORIA DEL CENTRO HTA)

(--- DEFINICION DE COORDENADAS Z ---)
#104 = -#3 (Z FINAL ABSOLUTO EN EL FONDO DE LA ROSCA)
#105 = #4 / 2 (ASCENSO EN Z DURANTE LA MEDIA VUELTA DE ENTRADA/SALIDA)

(--- ENCABEZADO DE MAQUINA Y POSICIONAMIENTO ---)
T#20 M06 (LLAMAR HERRAMIENTA)
G90 G54 G17 G40 G80 G49
G00 X#10 Y#11 (POSICIONAMIENTO EN EL CENTRO EXACTO DEL AGUJERO)
G43 H#20 Z#9 (*** VERIFICAR CORRECTOR DE ALTURA H ***)
S#100 M03
M08

(--- ACERCAMIENTO RAPIDO ---)
G00 Z2.0 (ACERCAMIENTO HASTA 2MM POR ENCIMA DEL MATERIAL)

(========================================)
(    BUCLE EXTERNO DE PASADAS RADIALES   )
(========================================)
#120 = 1 (CONTADOR DE PASADA RADIAL ACTUAL - INICIA EN PASADA 1)

N50 (--- INICIO BUCLE RADIAL ---)
IF [#120 GT #12] GOTO 999

(CALCULO DEL RADIO EFECTIVO PARA ESTA PASADA RADIAL)
(PASADA 1 = radio mas pequeno, ULTIMA PASADA = radio final #102)
#121 = #102 - [[#12 - #120] * #13]
IF [#121 LE 0] THEN #121 = #13 (SEGURIDAD: RADIO MINIMO IGUAL A UNA PROFUNDIDAD)

(RADIO DE LOS ARCOS DE ENTRADA/SALIDA TANGENCIAL PARA ESTA PASADA)
#122 = #121 / 2

(AVANCE COMPENSADO PARA INTERPOLACION CIRCULAR INTERNA EN ESTE RADIO)
#106 = ROUND[#101 * #121 / [#1 / 2]]

(BAJADA CONTROLADA POR EL CENTRO AL FONDO DE LA ROSCA)
G01 Z#104 F[#101 / 2]

(--- ARCO TANGENCIAL DE ENTRADA DE 180 GRADOS ---)
G03 X[#10 + #121] Y#11 Z[#104 + #105] I[#122] J0. F#106

(--- INICIALIZACION DEL BUCLE HELICOIDAL ---)
#110 = 0 (CONTADOR DE VUELTAS)
#111 = #104 + #105 (COORDENADA Z ACTUAL DESPUES DE LA ENTRADA)

N100 (--- BUCLE HELICOIDAL PRINCIPAL ---)
IF [#110 GE #5] GOTO 200 (SI COMPLETO LAS VUELTAS, SALTA A LA SALIDA)
#111 = #111 + #4 (CALCULA EL Z PARA LA SIGUIENTE VUELTA SUMANDO UN PASO)

(INTERPOLACION HELICOIDAL DE 360 GRADOS)
G03 X[#10 + #121] Y#11 Z#111 I-[#121] J0. F#106

#110 = #110 + 1 (INCREMENTA EL CONTADOR)
GOTO 100 (REPITE EL BUCLE)

N200 (--- FIN DEL BUCLE HELICOIDAL ---)

(--- ARCO TANGENCIAL DE SALIDA DE 180 GRADOS ---)
(CINEMATICA SEGURA: LA HERRAMIENTA VUELVE AL CENTRO ANTES DE SUBIR Z)
#111 = #111 + #105 (CALCULA EL ASCENSO Z PARA LA SALIDA TANGENCIAL)
G03 X#10 Y#11 Z#111 I-[#122] J0. F#106

(RETRACCION AL PLANO RAPIDO PARA PREPARAR SIGUIENTE PASADA RADIAL)
G00 Z2.0

#120 = #120 + 1 (INCREMENTA CONTADOR DE PASADA RADIAL)
GOTO 50 (REGRESA AL INICIO DEL BUCLE RADIAL)

N999 (--- FIN DE MECANIZADO ---)
G00 Z#9 (RETIRADA FINAL AL PLANO SEGURO)
M09
M05
G28 G91 Z0.
G90
M30

(--- ALARMAS Y ERRORES ---)
N9001 #3000=1 (ERROR: FRESA MAYOR O IGUAL QUE EL DIAMETRO DE ROSCA)
N9002 #3000=2 (ERROR: PASO DE ROSCA DEBE SER MAYOR A CERO)
N9003 #3000=3 (ERROR: EL NUMERO DE VUELTAS DEBE SER MINIMO 1)
N9004 #3000=4 (ERROR: NUMERO DE PASADAS RADIALES DEBE SER MINIMO 1)
N9005 #3000=5 (ERROR: PROFUNDIDAD RADIAL POR PASADA DEBE SER MAYOR A CERO)
