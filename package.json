{
  "name": "ng-macros-cnc-studio",
  "version": "4.4.0",
  "private": true,
  "description": "Configurador, simulador y generador de código G para macros Fanuc Custom Macro B.",
  "author": "Ingeniero Nestor Gamez",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "parse": "python3 parse_macros.py",
    "test": "node --test tests/*.test.mjs",
