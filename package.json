    "serve": "python3 -m http.server 8080",
    "license:keygen": "node tools/license-generator.mjs keygen",
    "license:issue": "node tools/license-generator.mjs issue",
    "license:verify": "node tools/license-generator.mjs verify"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cnc",
    "fanuc",
    "custom-macro-b",
    "gcode",
    "g65"
  ]
