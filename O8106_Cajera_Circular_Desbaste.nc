%
O8106 (DESBASTE DE CAJERA CIRCULAR)
(INGENIERO NESTOR GAMEZ - FANUC CNC CUSTOM MACROS)
(LLAMADA G65: G65 P8106 X.. Y.. D.. T.. F.. S.. Z.. K.. W.. U.. V.. R..)

(VARIABLES DE ENTRADA DEL OPERARIO)
(1. DIMENSIONES GEOMETRICAS DE LA PIEZA)
#24 = 0.0    (X: COORDENADA X DEL CENTRO DE LA CAJERA)
#25 = 0.0    (Y: COORDENADA Y DEL CENTRO DE LA CAJERA)
#7  = 80.0   (D: DIAMETRO FINAL DE LA CAJERA)

(2. CONDICIONES DE CORTE Y HERRAMIENTA)
#20 = 10.0   (T: DIAMETRO DE LA FRESA DE CORTE)
#9  = 400.0  (F: AVANCE DE MECANIZADO EN MM/MIN)
#19 = 1800.0 (S: VELOCIDAD DEL HUSILLO EN RPM)

(3. ESTRATEGIA DE MECANIZADO Y SOBREMATERIAL DE ACABADO)
#26 = 15.0   (Z: PROFUNDIDAD TOTAL DE LA CAJERA)
#6  = 3.0    (K: PROFUNDIDAD POR PASADA EN EJE Z)
#23 = 6.0    (W: ANCHO DE CORTE RADIAL O PASO LATERAL)
#21 = 0.5    (U: SOBREMATERIAL DE ACABADO EN PAREDES LATERALES)
#22 = 0.2    (V: SOBREMATERIAL DE ACABADO EN EL FONDO Z)
#18 = 2.0    (R: PLANO DE RETROCESO Y SEGURIDAD EN Z)

(CONTROL DE ERRORES Y SEGURIDAD)
IF [#7 LE 0]  GOTO9101
IF [#20 LE 0] GOTO9102
IF [#23 LE 0] GOTO9103
IF [#26 LE 0] GOTO9104
IF [#9 LE 0]  GOTO9105
IF [#6 LE 0]  GOTO9107
IF [#18 LT 0] #18 = 2.0

#10 = #4003
#14 = #7 / 2.0 (RADIO NOMINAL FINAL DE LA CAJERA)
#15 = #20 / 2.0 (RADIO DE LA FRESA)
#21 = ABS[#21] (SOBREMATERIAL PAREDES U)
#22 = ABS[#22] (SOBREMATERIAL FONDO V)

(CALCULO DE RADIO Y PROFUNDIDAD EFECTIVA DE DESBASTE)
#12 = #14 - #21 (RADIO DE DESBASTE DEJANDO SOBREMATERIAL U)
IF [#15 GE #12] GOTO9106 (RADIO FRESA MAYOR QUE EL RADIO DE DESBASTE)

#4 = #12 - #15 (RADIO MAXIMO DEL CENTRO DE LA FRESA EN DESBASTE)

#26 = ABS[#26]
#6  = ABS[#6]
#27 = #26 - #22 (PROFUNDIDAD DE DESBASTE DEJANDO SOBREMATERIAL V EN FONDO)
IF [#27 LE 0] #27 = #26

(ARRANQUE DE HUSILLO Y POSICIONAMIENTO EN CENTRO)
G90 G00 S#19 M03
G00 X#24 Y#25
G00 Z#18

(BUCLE PRINCIPAL DE PROFUNDIDAD EN Z)
#16 = 0.0
WHILE [#16 LT #27] DO1
  #16 = #16 + #6
  IF [#16 GT #27] THEN #16 = #27
  
  (BAJADA EN Z AL CENTRO)
  G90 G01 Z-[#16] F[#9 / 2.0]
  
  (ESPIRAL CONCENTRICA HACIA AFUERA)
  #33 = #23
  WHILE [#33 LT #4] DO2
    G90 G01 X[#24 + #33] F#9
    G03 I-[#33]
    #33 = #33 + #23
  END2
  
  (PASADA PERIMETRAL EN EL LIMITE DE DESBASTE)
  G90 G01 X[#24 + #4] F#9
  G03 I-[#4]
  
  (RETORNO RAPIDO AL CENTRO DE LA CAJERA)
  G90 G01 X#24 F[#9 * 2.0]
END1

(RETIRADA A PLANO DE SEGURIDAD)
G90 G00 Z#18
G00 Z25.0
GOTO9999

(MENSAJES DE ALARMA DE SEGURIDAD #3000)
N9101 #3000 = 101 (DIAMETRO DE LA CAJERA DEBE SER MAYOR A CERO)
N9102 #3000 = 102 (DIAMETRO DE HERRAMIENTA T DEBE SER MAYOR A CERO)
N9103 #3000 = 103 (PASO RADIAL W DEBE SER MAYOR A CERO)
N9104 #3000 = 104 (PROFUNDIDAD Z DEBE SER MAYOR A CERO)
N9105 #3000 = 105 (AVANCE F DEBE SER MAYOR A CERO)
N9106 #3000 = 106 (HERRAMIENTA Y SOBREMATERIAL EXCEDEN CAJERA)
N9107 #3000 = 107 (PASO EN Z K DEBE SER MAYOR A CERO)

N9999 G#10
M99
%
