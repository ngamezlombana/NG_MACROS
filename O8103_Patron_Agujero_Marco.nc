%
O8103 (PATRON DE AGUJERO DE MARCO RECTANGULAR)
(INGENIERO NESTOR GAMEZ - FANUC CNC CUSTOM MACROS)
(LLAMADA G65: G65 P8103 X.. Y.. U.. V.. I.. J.. T.. F.. S.. Z.. R.. E..)

(VARIABLES DE ENTRADA DEL OPERARIO)
(1. DIMENSIONES GEOMETRICAS)
#24 = 20.0   (X: COORDENADA X ESQUINA INFERIOR IZQUIERDA)
#25 = 20.0   (Y: COORDENADA Y ESQUINA INFERIOR IZQUIERDA)
#21 = 6.0    (U: CANTIDAD DE AGUJEROS EN EJE X HORIZONTAL)
#22 = 4.0    (V: CANTIDAD DE AGUJEROS EN EJE Y VERTICAL)
#4  = 25.0   (I: PASO O DISTANCIA ENTRE AGUJEROS EN X)
#5  = 20.0   (J: PASO O DISTANCIA ENTRE AGUJEROS EN Y)

(2. CONDICIONES DE CORTE Y HERRAMIENTA)
#20 = 10.0   (T: DIAMETRO DE LA BROCA / HERRAMIENTA)
#9  = 250.0  (F: AVANCE DE TALADRADO EN MM/MIN)
#19 = 1200.0 (S: VELOCIDAD DEL HUSILLO EN RPM)

(3. ESTRATEGIA DE PERFORADO Y SEGURIDAD)
#26 = 18.0   (Z: PROFUNDIDAD TOTAL DE PERFORACION)
#18 = 2.0    (R: PLANO DE RETROCESO Y SEGURIDAD)
#8  = 5.0    (E: PASO DE PICOTEO EN Z PARA G83)

(CONTROL DE ERRORES Y SEGURIDAD)
#10 = #4003
IF [#4 LE 0] GOTO9101
IF [#5 LE 0] GOTO9101
IF [#21 LT 2] GOTO9102
IF [#22 LT 2] GOTO9102
IF [#21 NE FUP[#21]] GOTO9103
IF [#22 NE FUP[#22]] GOTO9103
IF [#26 LE 0] GOTO9104
IF [#9 LE 0] GOTO9105
IF [#20 LE 0] GOTO9106
IF [#8 LE 0] GOTO9107
IF [#18 LT 0] #18 = 2.0

(ARRANQUE DE HUSILLO Y POSICIONAMIENTO EN ESQUINA)
G90 G00 S#19 M03
G00 X#24 Y#25
G00 Z#18

(INICIAR CICLO FIJO DE TALADRADO G83)
G99 G83 X#24 Y#25 Z-[#26] R#18 Q#8 F#9

(1. LADO INFERIOR: HACIA X+ DERECHA)
#33 = #21 - 1
WHILE [#33 GT 0] DO1
  G91 X#4
  #33 = #33 - 1
END1

(2. LADO DERECHO: HACIA Y+ ARRIBA)
#33 = #22 - 1
WHILE [#33 GT 0] DO1
  G91 Y#5
  #33 = #33 - 1
END1

(3. LADO SUPERIOR: HACIA X- IZQUIERDA)
#33 = #21 - 1
WHILE [#33 GT 0] DO1
  G91 X-[#4]
  #33 = #33 - 1
END1

(4. LADO IZQUIERDO: HACIA Y- ABAJO OMITE PRIMER AGUJERO YA TALADRADO)
#33 = #22 - 1
WHILE [#33 GT 1] DO1
  G91 Y-[#5]
  #33 = #33 - 1
END1

G80 (CANCELAR CICLO FIJO)
G90 G00 Z25.0
GOTO9999

(MENSAJES DE ALARMA DE SEGURIDAD #3000)
N9101 #3000 = 101 (PASO I Y J DEBEN SER MAYORES A CERO)
N9102 #3000 = 102 (MINIMO 2 AGUJEROS POR CADA LADO)
N9103 #3000 = 103 (CANTIDAD DE AGUJEROS DEBE SER ENTERO)
N9104 #3000 = 104 (PROFUNDIDAD Z DEBE SER MAYOR A CERO)
N9105 #3000 = 105 (AVANCE F DEBE SER MAYOR A CERO)
N9106 #3000 = 106 (DIAMETRO DE HERRAMIENTA T DEBE SER MAYOR A CERO)
N9107 #3000 = 107 (PASO DE PICOTEO E DEBE SER MAYOR A CERO)

N9999 G#10
M99
%
