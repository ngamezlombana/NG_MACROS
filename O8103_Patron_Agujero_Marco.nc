%
O8103 (PATRON DE AGUJERO DE MARCO RECTANGULAR)
(PETER SMID - FANUC CNC CUSTOM MACROS - CAPITULO 20)
(LLAMADA G65: G65 P8103 X.. Y.. U.. V.. I.. J..)

(VARIABLES DE ENTRADA DEL OPERARIO)
#24 = 20.0  (X: COORDENADA X ESQUINA INFERIOR IZQUIERDA)
#25 = 20.0  (Y: COORDENADA Y ESQUINA INFERIOR IZQUIERDA)
#21 = 6.0   (U: CANTIDAD DE AGUJEROS EN EJE X HORIZONTAL)
#22 = 4.0   (V: CANTIDAD DE AGUJEROS EN EJE Y VERTICAL)
#4  = 25.0  (I: PASO O DISTANCIA ENTRE AGUJEROS EN X)
#5  = 20.0  (J: PASO O DISTANCIA ENTRE AGUJEROS EN Y)

(CONTROL DE ERRORES Y SEGURIDAD)
#10 = #4003
IF [#4 LE 0] GOTO9101
IF [#5 LE 0] GOTO9101
IF [#21 LT 2] GOTO9102
IF [#22 LT 2] GOTO9102
IF [#21 NE FUP[#21]] GOTO9103
IF [#22 NE FUP[#22]] GOTO9103

(POSICIONAMIENTO EN PRIMER AGUJERO ESQUINA INFERIOR IZQUIERDA)
G90 G00 X#24 Y#25

(1. LADO INFERIOR: HACIA X+ DERECHA)
#33 = #21 - 1
WHILE [#33 GT 0] DO1
  G91 X#4
  #33 = #33 - 1
END1

(2. LADO DERECHO: HACIA Y+ ARRIBA)
#33 = #22 - 1
WHILE [#33 GT 0] DO1
  G91 Y#5
  #33 = #33 - 1
END1

(3. LADO SUPERIOR: HACIA X- IZQUIERDA)
#33 = #21 - 1
WHILE [#33 GT 0] DO1
  G91 X-[#4]
  #33 = #33 - 1
END1

(4. LADO IZQUIERDO: HACIA Y- ABAJO OMITE PRIMER AGUJERO YA TALADRADO)
#33 = #22 - 1
WHILE [#33 GT 1] DO1
  G91 Y-[#5]
  #33 = #33 - 1
END1

GOTO9999

(MENSAJES DE ALARMA DE SEGURIDAD #3000)
N9101 #3000 = 101 (PASO I Y J DEBEN SER MAYORES A CERO)
N9102 #3000 = 102 (MINIMO 2 AGUJEROS POR CADA LADO)
N9103 #3000 = 103 (CANTIDAD DE AGUJEROS DEBE SER ENTERO)

N9999 G#10
M99
%
